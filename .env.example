# Example environment for state-channels-plus. Copy to `.env` (gitignored) and
# override as needed. Values shown are the defaults.
#
# Two groups:
#   1. SDK config  — read through src/utils/config.ts (env > peer3.config > defaults)
#   2. Test / parallel-runner infra — read directly by scripts/ and the harness;
#      most are set automatically by the parallel runner, listed here for reference.

# =============================================================================
# 1. SDK config (Config keys in src/utils/config.ts)
# =============================================================================

# JSON-RPC endpoint the SDK builds its provider from.
PROVIDER_URL=http://localhost:8545

# LocalDiscovery registry ws:// URL. Empty → in-process discovery server.
LOCAL_DISCOVERY_REGISTRY_URL=
# Holepunch relayer URLs — JSON array (["wss://..."]) or comma/space separated.
HOLEPUNCH_RELAYER_URLS=

# Log level: verbose | debug | info | warn | error
LOG_LEVEL=info
LOG_SKIP_WRITING=false
# Comma-separated log tags to exclude (both are honored).
LOG_EXCLUDE_TAGS=
EXCLUDE_LOG_TAGS=

# Component debug toggles.
DEBUG_STATE_MANAGER=false
DEBUG_DISPUTE_HANDLER=false
DEBUG_P2P_MANAGER=false
DEBUG_RPC=false
DEBUG_CHANNEL_CONTRACT=false
DEBUG_LOCAL_TRANSPORT=false

# Run the VM / SDK in dedicated worker threads.
VM_DEDICATED_THREAD=false
RUN_SDK_IN_THREAD=false

# Logger event-loop delay monitor: throw when a single delay exceeds this many
# seconds (0 disables). >0 also enables the ##E2E_TIMING## diagnostics the
# parallel runner parses (per-thread delay peaks, worker boot times). Tests set
# 1 via peer3.test.config.
EVENT_LOOP_DELAY_ERROR_THRESHOLD_SECONDS=0

# Crash-log upload (disabled when endpoint empty).
CRASH_LOG_UPLOAD_ENDPOINT=
CRASH_LOG_API_TOKEN=
CRASH_LOG_MAX_SIZE_MB=10

# =============================================================================
# 2. Test / parallel-runner infra (scripts/ + test harness)
# =============================================================================

# --- Hardhat node / chain ---------------------------------------------------
# E2E: automine off + 2s interval mining so block-time tracks wall-clock. The
# parallel runner sets this to "1"; hardhat.config gates on it.
E2E_INTERVAL_MINING=
# External hardhat node the harness/runner target (harness starts one if unset).
HARDHAT_NODE_URL=
# Host/port for the standalone node scripts (scripts/infra/*).
HARDHAT_NODE_HOST=127.0.0.1
HARDHAT_NODE_PORT=18545
# Bind for a spawned LocalDiscovery registry (set by nodeInfra when it spawns one).
LOCAL_DISCOVERY_HOST=127.0.0.1
LOCAL_DISCOVERY_PORT=

# --- Harness deploy cache / accounts (set per-slot/per-test by the runner) ---
# Dir holding <deployKey>.addr markers so same-config tests reuse a deployment.
E2E_MANAGER_CACHE_DIR=
# Explicit StateChannelManager address to reuse instead of deploying.
E2E_REUSE_MANAGER_ADDRESS=
# Account-partition index (index * SLOT_STRIDE) so concurrent tests don't collide.
E2E_SLOT_INDEX=

# --- Parallel runner output -------------------------------------------------
# "1" mirrors each test child's stdout/stderr to the runner console.
STREAM_PARALLEL_CHILD_OUTPUT=0

# --- Worker heap caps (MB) --------------------------------------------------
# Cap SDK worker-thread old-space so a runaway test fails cleanly instead of
# OOM-killing the machine. Per-role vars win over the shared one; <=0 disables.
SCP_WORKER_MAX_OLD_SPACE_MB=1024
SCP_SDK_WORKER_MAX_OLD_SPACE_MB=
SCP_VM_WORKER_MAX_OLD_SPACE_MB=

# --- Crash-log dev server (scripts/logging/crash-log-server.js) -------------
CRASH_LOG_SERVER_PORT=3001
CRASH_LOG_DIR=

# --- Set by the environment, not you ----------------------------------------
# NODE_OPTIONS / TERM / FORCE_COLOR are injected into test children by the runner.
# GITHUB_ACTIONS is set by CI.
