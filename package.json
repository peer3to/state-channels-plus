{
  "name": "@peer3/state-channels-plus",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "version": "0.0.7",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peer3to/state-channels-plus.git"
  },
  "license": "MIT",
  "peerDependencies": {
    "ethers": "6.13.7"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.0",
    "@nomicfoundation/hardhat-ethers": "^3.0.0",
    "@nomicfoundation/hardhat-foundry": "^1.1.3",
    "@nomicfoundation/hardhat-ignition-ethers": "^3.0.5",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.0",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.0",
    "@nomiclabs/hardhat-truffle5": "2.0.7",
    "@nomiclabs/hardhat-web3": "2.0.0",
    "@swc/core": "^1.15.41",
    "@swc/helpers": "^0.5.23",
    "@typechain/ethers-v6": "^0.5.0",
    "@typechain/hardhat": "^9.0.0",
    "@types/chai": "4",
    "@types/lodash.clonedeep": "^4.5.9",
    "@types/mocha": ">=9.1.0",
    "@types/node": "^20.11.24",
    "@types/sinon": "^17.0.4",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "chai": "^4.2.0",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "eslint": "^9.35.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unused-imports": "^4.2.0",
    "ethers": "6.13.7",
    "express": "^4.19.2",
    "hardhat-gas-reporter": "^1.0.8",
    "husky": "^8.0.3",
    "lint-staged": "^14.0.1",
    "nyc": "^15.1.0",
    "playwright": "^1.55.0",
    "prettier": "^3.2.5",
    "rimraf": "^6.0.1",
    "sinon": "^20.0.0",
    "solidity-coverage": "^0.8.1",
    "source-map-support": "^0.5.21",
    "tsc-alias": "^1.8.16",
    "typechain": "^8.3.0",
    "vite": "^7.1.5",
    "web3": "4.5.0"
  },
  "dependencies": {
    "@ethereumjs/evm": "^3.1.0",
    "@ganache/console.log": "^0.4.2",
    "@hyperswarm/dht": "^6.0.1",
    "@hyperswarm/dht-relay": "0.3.0",
    "@nomiclabs/hardhat-ethers": "2.2.3",
    "@nomiclabs/hardhat-waffle": "2.0.6",
    "@openzeppelin/contracts": "^5.0.2",
    "axios": "^1.6.8",
    "buffer": "^6.0.3",
    "ethereum-waffle": "4.0.10",
    "fflate": "^0.8.2",
    "fs-ext": "^2.1.1",
    "get-webrtc": "^1.0.1",
    "glob": "10.3.10",
    "hardhat": "^2.22.1",
    "hyperswarm": "4.3.5",
    "mocha": "10.7.3",
    "prompt": "1.3.0",
    "tar": "^7.4.3",
    "ts-morph": "^27.0.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3",
    "ws": "^8.18.0"
  },
  "engines": {
    "yarn": ">=1.15"
  },
  "scripts": {
    "compile": "yarn hardhat clean && yarn hardhat compile --force && yarn hardhat typechain && yarn generate-enums && yarn generate-artifacts",
    "copy:test-runtime-utils": "node scripts/copy-test-runtime-utils.js",
    "infra:hardhat-node": "node scripts/infra/start-hardhat-node.js",
    "infra:local-discovery": "node scripts/infra/local-discovery-registry.js",
    "dev:tsc": "tsc -w -p tsconfig.json",
    "generate-enums": "ts-node scripts/generate-enums.ts",
    "generate-artifacts": "node scripts/generate-artifacts.js",
    "get-logs": "ts-node scripts/logging/fetch-logs.ts",
    "logs:clean": "node scripts/clean-test-run-logs.js",
    "test": "yarn hardhat test --no-compile $(find test -name '*.test.ts' -not -path 'test/e2e/*')",
    "test:browser:worker": "yarn build:browser && node test/browser/run-worker-contract-executor.mjs",
    "test:browser:webrtc": "node test/browser/run-p2p-webrtc-e2e.mjs",
    "test:debug": "yarn hardhat test --no-compile $(find test -name '*.test.ts')",
    "test:all": "yarn hardhat test $(find test -name '*.test.ts')",
    "test:compile": "yarn compile && yarn test",
    "test:e2e:base": "E2E_INTERVAL_MINING=1 yarn hardhat test $(find ${TEST_DIR:-test/e2e} -name '*.test.ts')",
    "test:e2e": "LOG_LEVEL=warn yarn test:e2e:base",
    "test:e2e:worker": "node scripts/infra/run-e2e-worker.js",
    "test:e2e:log-file": "rm -rf ./logs/wtf.ansi && yarn test:e2e:verbose >> ./logs/wtf.ansi",
    "test:e2e:skip-log": "LOG_SKIP_WRITING=true yarn test:e2e:verbose",
    "test:e2e:info": "LOG_LEVEL=info yarn test:e2e:base",
    "test:e2e:debug": "LOG_LEVEL=debug yarn test:e2e:base",
    "test:e2e:verbose": "LOG_LEVEL=verbose yarn test:e2e:base",
    "test:unit:base": "TEST_DIR=test/unit yarn test:e2e:base",
    "test:unit": "TEST_DIR=test/unit yarn test:e2e",
    "test:unit:worker": "node scripts/infra/run-e2e-worker.js test/unit",
    "test:unit:log-file": "TEST_DIR=test/unit yarn test:e2e:log-file",
    "test:unit:skip-log": "TEST_DIR=test/unit yarn test:e2e:skip-log",
    "test:unit:info": "TEST_DIR=test/unit yarn test:e2e:info",
    "test:unit:debug": "TEST_DIR=test/unit yarn test:e2e:debug",
    "test:unit:verbose": "TEST_DIR=test/unit yarn test:e2e:verbose",
    "test:parallel": "node scripts/test-e2e-parallel.js",
    "test:parallel:distributed": "node scripts/test-e2e-parallel.js --distributed",
    "test:parallel:server": "node scripts/e2e-parallel/distributed/server.js",
    "test:parallel:prepare": "hardhat clean && hardhat compile --force && hardhat typechain && node scripts/generate-artifacts.js && yarn test:parallel:prepare:cached-contracts",
    "test:parallel:prepare:cached-contracts": "ts-node scripts/generate-enums.ts && rimraf dist && mkdir -p dist && tsc && tsc-alias -p tsconfig.json && node scripts/copy-test-runtime-utils.js",
    "test:parallel:debug": "LOG_LEVEL=debug node scripts/test-e2e-parallel.js",
    "test:parallel:verbose": "LOG_LEVEL=verbose node scripts/test-e2e-parallel.js",
    "test:coverage": "nyc --reporter=html yarn test",
    "test:profile:e2e": "LOG_LEVEL=verbose node --enable-source-maps --cpu-prof --cpu-prof-dir=./profiles --cpu-prof-name=e2e-verbose.cpuprofile ./node_modules/hardhat/internal/cli/cli.js test $(find test/e2e -name '*.test.ts')",
    "test:profile:e2e:inspector": "LOG_LEVEL=verbose node --inspect-brk --enable-source-maps ./node_modules/hardhat/internal/cli/cli.js test $(find test/e2e -name '*.test.ts')",
    "test:profile:e2e:clinic:flame": "LOG_LEVEL=verbose npx clinic flame --dest ./profiles/clinic -- node ./node_modules/hardhat/internal/cli/cli.js test $(find test/e2e -name '*.test.ts')",
    "test:profile:e2e:clinic:doctor": "LOG_LEVEL=verbose npx clinic doctor --dest ./profiles/clinic -- node ./node_modules/hardhat/internal/cli/cli.js test $(find test/e2e -name '*.test.ts')",
    "test:profile:e2e:v8": "LOG_LEVEL=verbose node --prof --enable-source-maps ./node_modules/hardhat/internal/cli/cli.js test $(find test/e2e -name '*.test.ts')",
    "test:profile:e2e:v8:process": "node --prof-process isolate-*.log > ./profiles/v8-prof.txt",
    "build:browser": "rimraf dist/browser && tsc -p tsconfig.browser.json && tsc-alias -p tsconfig.browser.json",
    "build": "yarn compile && rimraf dist && mkdir -p dist && tsc && tsc-alias -p tsconfig.json && yarn copy:test-runtime-utils && yarn build:browser && npm pack && node rename-pack.js",
    "spec:refresh": "node docs/spec/claude/tools/generate-specification-index.js && node docs/spec/claude/tools/audit-implementation-mirror.js && node docs/spec/claude/tools/audit-verification.js && node docs/spec/claude/tools/generate-open-questions-index.js && node docs/spec/claude/tools/generate-audit-summary.js && prettier --write docs/spec/claude/generated/*.md && node docs/spec/claude/tools/generate-specification-index.js --check && node docs/spec/claude/tools/audit-implementation-mirror.js --check && node docs/spec/claude/tools/audit-verification.js --check && node docs/spec/claude/tools/generate-open-questions-index.js --check && node docs/spec/claude/tools/generate-audit-summary.js --check",
    "spec:refresh:strict": "yarn spec:refresh && node docs/spec/claude/tools/generate-specification-index.js --check --strict && node docs/spec/claude/tools/audit-implementation-mirror.js --check --strict && node docs/spec/claude/tools/audit-verification.js --check --strict && node docs/spec/claude/tools/generate-open-questions-index.js --check --strict && node docs/spec/claude/tools/generate-audit-summary.js --check --strict",
    "spec:impact": "node docs/spec/claude/tools/report-change-impact.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:fix": "eslint src/**/*.ts test/**/*.ts --fix",
    "lint:fix-only": "eslint src/**/*.ts test/**/*.ts --fix --quiet || true",
    "prepare": "husky install"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "yarn lint:fix-only",
      "prettier --write"
    ],
    "*.{json,md}": "prettier --write",
    "*.sol": "forge fmt"
  },
  "files": [
    "dist",
    "contracts",
    "artifacts",
    "hardhat.config.ts",
    "scripts/e2e-parallel",
    "scripts/test-e2e-parallel.js",
    "scripts/infra",
    "test/utils/nodeInfra.js",
    "test/utils/nodeInfra.d.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "browser": "./dist/browser/src/index.js",
      "node": "./dist/src/index.js",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./test-harness": {
      "types": "./dist/test-harness.d.ts",
      "import": "./dist/test-harness.js",
      "default": "./dist/test-harness.js"
    },
    "./test-parallel": "./scripts/test-e2e-parallel.js",
    "./test-parallel-server": "./scripts/e2e-parallel/distributed/server.js",
    "./test-parallel-worker": "./scripts/e2e-parallel/distributed/worker.js",
    "./contracts/*": "./contracts/*"
  },
  "description": "This is an SDK for creating scalable and resilient client side peer-to-peer (p2p) state channels for arbitrary state machines with shared security inherited from a distributed ledger (blockchain).",
  "bugs": {
    "url": "https://github.com/peer3to/state-channels-plus/issues"
  },
  "homepage": "https://github.com/peer3to/state-channels-plus#readme",
  "directories": {
    "doc": "docs",
    "example": "examples",
    "test": "test"
  },
  "author": "",
  "pnpm": {
    "onlyBuiltDependencies": [
      "fs-ext"
    ]
  },
  "peer3TestDistribution": {
    "prepareScript": "test:parallel:prepare",
    "cachedPrepareScript": "test:parallel:prepare:cached-contracts",
    "verifyNativeModules": [
      "fs-ext"
    ],
    "contractCompileInputs": [
      "contracts/",
      "hardhat.config.ts",
      "package.json",
      "pnpm-lock.yaml",
      "yarn.lock",
      "scripts/generate-artifacts.js"
    ]
  }
}
