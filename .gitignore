peer3.config.json


# foundry stuff
# lib/* (not bare "lib") so the forge-std submodule can be re-included:
# git never descends into an ignored directory, so !/lib/forge-std only works
# when lib itself stays unignored. The distributed test bundle drops every
# tracked-but-ignored path, and forge test needs forge-std on the workers.
/lib/*
!/lib/forge-std
out
cache_forge

temp
logs
crash-logs

# generated files
src/types/sol-enums.ts
src/utils/GeneratedArtifacts.ts
docs/spec/generated/

# TypeScript incremental build info
*.tsbuildinfo

/profiles

/extensions
