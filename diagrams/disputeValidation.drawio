                <mxCell id="439" value="struct Dispute{&lt;br&gt;...&lt;br&gt;(add) postedAuditingData: bool&lt;br&gt;(keep) auditingDataHash: Hash&lt;br&gt;}&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;struct DisputeAuditingData{&lt;/div&gt;&lt;div&gt;(change) latestStateEncoded -&amp;gt; latest&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;b&gt;Finalized&lt;/b&gt;&lt;/font&gt;StateEncoded&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="438">
                    <mxGeometry y="30" width="399" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="441" value="Note" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="dv-frame">
                    <mxGeometry x="1390" y="25.5" width="410" height="390" as="geometry">
                        <mxRectangle x="50" y="140" width="70" height="30" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="442" value="Takes into account &lt;b&gt;all the signatures&lt;/b&gt; from the &lt;b&gt;on-chain snapshot&lt;/b&gt; and &lt;b&gt;InboundMessages&lt;/b&gt; upto the target hash of the dispute (dispute.latestInboundMessageBlockHash) - the dispute at cration is forced to use the latest InboundMessageBlockHash or its on-chain commitment will be rejected -&amp;gt; it&#39;s aware of the signature set expected and only if that siganture set has finalized the latest milestone, can the dispute be commited without posting AuditingData, since everyone can derive it&lt;div&gt;&lt;br&gt;&lt;br&gt;We can allow the on-chain snapshot to be updated while the dispute game is ongoing and thus potentially expanding the siganture set and causing this proof to become VALID, but an honest peer would have to sign or has already signed such milestone, for the milestone to become final and used to update the snapshot on-chain&amp;nbsp; -&amp;gt; it&#39;s AWARE of the largest participant set -&amp;gt; so a malicous subset can not collude to substitute the snapshot to anything that the honest peer didn&#39;t take into account already.&lt;br&gt;&lt;br&gt;If the particpant set dynamically expands and contracts off-chain, the honest participant should do a &lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;multicall&lt;/font&gt; and &lt;b&gt;update the snaspshot&lt;/b&gt; to the latest milestone possible to checkpoint it on-chain and thus preventing a potential malicious set from presneting a &#39;&lt;b&gt;middle snapshot&lt;/b&gt;&#39; that may contain a larger (and outdated) participant set, which could cause this proof to be VALID and slash an honest commiter.&lt;/div&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="441">
                    <mxGeometry y="30" width="410" height="360" as="geometry"/>
                </mxCell>
                <mxCell id="444" value="&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;font&gt;persist dispute fraud proof&lt;/font&gt;&lt;/font&gt;&lt;div&gt;&lt;b&gt;LastMilestoneNotFinalAndNoAuditingData&lt;/b&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="dv-frame">
