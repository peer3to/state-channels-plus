                <mxCell id="455" value="verifyStateProof" style="shape=mxgraph.flowchart.decision;whiteSpace=wrap;html=1;" vertex="1" parent="dv-frame">
                    <mxGeometry x="570.5" y="570" width="229" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="456" value="&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;font&gt;persist dispute fraud proof&lt;/font&gt;&lt;/font&gt;&lt;div&gt;&lt;b&gt;InvalidStateProof(withIntegrityVerified)&lt;/b&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="dv-frame">
                    <mxGeometry x="189" y="587.5" width="300" height="75" as="geometry"/>
                </mxCell>
                <mxCell id="458" value="&lt;div&gt;run all stateProof blocks through the pipeline to try and catch fraud&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="dv-frame">
                    <mxGeometry x="861" y="977" width="250" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="461" value="Note" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="dv-frame">
                    <mxGeometry x="1140" y="937" width="260" height="360" as="geometry">
                        <mxRectangle x="50" y="140" width="70" height="30" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="462" value="The pipeline should catch potential fraud - double sign, invalid state transition, blocks not linked in the stateProof and persist the fraudProofs in storage.&amp;nbsp;&lt;br&gt;&lt;br&gt;Also for dispute fraud proofs - but run the entire pipeline, not short circuti it, so we detect and punish all fraud.&amp;nbsp;&lt;br&gt;&lt;br&gt;After the pipeline we can short circut if there&#39;s a disptue fraud proof available to kill the dispute - all is done with a single transaction and a multicall under the hood&amp;nbsp;&lt;br&gt;&lt;br&gt;Persist only by HASH - unordered - so we don&#39;t alter our perception of the latest state, but we do keep the evidence and state, so we can catch more fraud and more importantly REDUCE later" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="461">
                    <mxGeometry y="30" width="260" height="330" as="geometry"/>
                </mxCell>
                <mxCell id="463" value="&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;font&gt;persist dispute fraud proof&lt;/font&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;font&gt;&lt;b&gt;InvalidBlockInStateProofApplyFraudProof&lt;/b&gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="dv-frame">
                    <mxGeometry x="440" y="1267" width="300" height="75" as="geometry"/>
                </mxCell>
                <mxCell id="464" value="Think" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="dv-frame">
                    <mxGeometry x="600" y="957" width="230" height="220" as="geometry">
                        <mxRectangle x="120" y="500" width="70" height="30" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="465" value="Not sure does the pipeline account of consequtive blocks are not linked - since the OG pipeline goes block by block in isolation and when blocks are not linked it ignores - the stateProof is an atomic commitment on the structure -&amp;gt; so if blocks are not linked we can kill&amp;nbsp;&lt;br&gt;&lt;br&gt;Do we run on older milestones where we don&#39;t have the prior state? We don&#39;t gurantee DA for it -&amp;gt; think" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="464">
                    <mxGeometry y="30" width="230" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="466" value="dispute fraud proof detected?" style="shape=mxgraph.flowchart.decision;whiteSpace=wrap;html=1;" vertex="1" parent="dv-frame">
                    <mxGeometry x="886" y="1234.5" width="200" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="467" style="edgeStyle=none;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="dv-frame" source="458" target="466">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="469" style="edgeStyle=none;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;exitPerimeter=0;" edge="1" parent="dv-frame" source="466" target="463">
