                </mxCell>
                <mxCell id="471" value="verifyLastMilestone finality takes into account inboundMessages correctly" style="shape=mxgraph.flowchart.decision;whiteSpace=wrap;html=1;" vertex="1" parent="dv-frame">
                    <mxGeometry x="824" y="1437" width="324" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="472" value="Note" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="dv-frame">
                    <mxGeometry x="1161" y="1352" width="380" height="530" as="geometry">
                        <mxRectangle x="50" y="140" width="70" height="30" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="473" value="The protocol guarantee data availability on the last finalized state, from which newer states can be dervied, but it doesn&#39;t guarantee corectness of the finalized state, so a new joiner may not be able to prove correctness of the state given and as such may not be able to challenge it, at least the state transition. A poisoned state can be given.&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;That&#39;s fine, since from a perspective of a new participant, they don&#39;t care about the state before them, they only care that the money/value invariant is preserved (deposits = balances + withdrawals) regardless of the actuall distribution, which we make available as an O(1) check on the state given (made available). This gurantees to them that the money/value is correct before thier deposit is injected and they&#39;ll actually verify the state transition that injects their balance.&lt;br&gt;&lt;br&gt;So what&#39;s important to gurantee to the new users is the state transition when their deposit is injected into the state.&amp;nbsp;&lt;br&gt;&lt;br&gt;If a block consumes an inboundMessage and claims finality on itself, it not only has to prove finality of the threshold set of the state machine at that point, but it also has to prove that the issuer of the inbound message signed and confirmed the block to be conisdered final - this gurantees to new joiners that they could audit the state transition of their join.&lt;br&gt;&lt;br&gt;If a block consumes an inboundMessage, but does not reach finality (including from the issuer of the inboundMessage) it can NOT be used as a finality anchor for data availability and a prior block has to be used instead, so the user has prior data to derive and verify that the state transition that injected them into the state machine with their deposit is correct.&amp;nbsp;&lt;br&gt;&lt;br&gt;If the last milestone does not respect this requirement, this fraud proof will kill the dispute and slash the issuer.&lt;/font&gt;&lt;/div&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="472">
                    <mxGeometry y="30" width="380" height="500" as="geometry"/>
                </mxCell>
                <mxCell id="474" value="&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;font&gt;persist dispute fraud proof&lt;/font&gt;&lt;/font&gt;&lt;div&gt;&lt;b&gt;LastMilestoneLacksInboundSignatures&lt;/b&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="dv-frame">
                    <mxGeometry x="440" y="1469.5" width="300" height="75" as="geometry"/>
                </mxCell>
                <mxCell id="475" style="edgeStyle=none;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="dv-frame" source="466" target="471">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="960" y="1477" as="sourcePoint"/>
                        <mxPoint x="1040" y="1477" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="476" value="False" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="475">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint y="-10" as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="479" style="edgeStyle=none;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;exitPerimeter=0;" edge="1" parent="dv-frame" source="471" target="474">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="960" y="1477" as="sourcePoint"/>
                        <mxPoint x="1040" y="1477" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
