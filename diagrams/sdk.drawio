                <mxCell id="ifsbyHzDkbNQgsuxaP6B-165" value="Note" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="MiHG-ok4c3-oJHMUXmo7-2" vertex="1">
                    <mxGeometry x="40" y="210" width="320" height="400" as="geometry">
                        <mxRectangle x="50" y="140" width="70" height="30" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="ifsbyHzDkbNQgsuxaP6B-166" value="The &lt;font style=&quot;color: rgb(0, 153, 77);&quot;&gt;onChainSnapshot&lt;/font&gt; is the single source of truth, that&#39;s always available. Apart from other things it contains the &lt;b&gt;forkId&lt;/b&gt;. - The forkId uniquely identifies the genesis state of the fork - it&#39;s the hash of the genesis state snapshot data.&amp;nbsp;&lt;div&gt;&lt;br&gt;Everyone builds on top of this forkId untill there is a dispute. The dispute creats a DisputeWindow for that forkId.&lt;br&gt;&lt;br&gt;The outcome of the dispute is another &lt;b&gt;forkId&lt;/b&gt; that&#39;s computed with &lt;b&gt;reduce()&lt;/b&gt;.&amp;nbsp;&lt;br&gt;&lt;br&gt;So the fork choice rule becomes:&lt;br&gt;&lt;font style=&quot;color: rgb(0, 102, 204);&quot;&gt;selectedFork = onChainSnapshot.forkId&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 102, 204);&quot;&gt;while(existsDisputeWindow(selectedFork){&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 102, 204);&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;selectedFork = &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;disputeWindow[selectedFork].reducedResult.forkId&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 102, 204);&quot;&gt;}&lt;br&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;Since the &lt;font style=&quot;color: rgb(0, 153, 77);&quot;&gt;onChainSnapshot &lt;/font&gt;is available on-chain, this same algorithm is used on-chain prove a snapshot update when the snapshot is not on the same fork as the onChainSnapshot - this same algorithm is used to prove the state to an independent observer (spectator).&lt;/div&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" parent="ifsbyHzDkbNQgsuxaP6B-165" vertex="1">
                    <mxGeometry y="30" width="320" height="370" as="geometry"/>
                </mxCell>
                <mxCell id="ODITfQRj00F-9atufKFF-8" value="Dispute Creation - Triggers" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;recursiveResize=0;container=1;collapsible=0;width=160;" parent="1" vertex="1">
