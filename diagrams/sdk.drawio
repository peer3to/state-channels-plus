                    </mxGeometry>
                </mxCell>
                <mxCell id="7IE0TgfvVyxq2MSAQDQT-43" value="Not sure is this component needed (mostly some helper functions) - will leave it here for now and see later does it make sense to be a seperate component or not" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" parent="7IE0TgfvVyxq2MSAQDQT-42" vertex="1">
                    <mxGeometry y="30" width="140" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="7IE0TgfvVyxq2MSAQDQT-45" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b style=&quot;&quot;&gt;All Components&lt;/b&gt; in the dependency graph have a &lt;b style=&quot;&quot;&gt;single instance&lt;/b&gt; -&amp;gt; are efectively a &lt;b style=&quot;&quot;&gt;singleton logically&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
