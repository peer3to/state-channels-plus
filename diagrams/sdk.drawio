                <mxCell id="04kf31U29QvEIDmgyHl--2" value="Since disputes happen in parralel and not knowing the order of other disputes and concurrent/parralel events (e.g. joining the channel) - Reduce has to be &lt;b&gt;statefull so all the stuff that happens in parralel is eventually reduce&lt;/b&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" parent="04kf31U29QvEIDmgyHl--1" vertex="1">
                    <mxGeometry y="30" width="190" height="140" as="geometry"/>
                </mxCell>
