                <mxCell id="RnoZjXUfups5RpbPsFKl-6" value="notify who&#39;s the next leader/participant to produce a block." style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" parent="RnoZjXUfups5RpbPsFKl-5" vertex="1">
