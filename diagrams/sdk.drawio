                <mxCell id="7IE0TgfvVyxq2MSAQDQT-39" value="Currently only the StateManager and RPC use this, but in general as we conclude the SDK all components should have their own deidcated hooks to triger so this component will be refrenced by all components more or less" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" parent="7IE0TgfvVyxq2MSAQDQT-38" vertex="1">
