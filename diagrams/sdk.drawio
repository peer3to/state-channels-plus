                <mxCell id="ODITfQRj00F-9atufKFF-68" value="Dispute Evidence Kill Window" style="rounded=1;whiteSpace=wrap;html=1;" parent="ODITfQRj00F-9atufKFF-27" vertex="1">
                    <mxGeometry x="1490" y="255" width="110" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="ODITfQRj00F-9atufKFF-70" value="" style="endArrow=classic;startArrow=classic;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="ODITfQRj00F-9atufKFF-27" target="ODITfQRj00F-9atufKFF-68" edge="1">
                    <mxGeometry width="50" height="50" relative="1" as="geometry">
                        <mxPoint x="980" y="269.58000000000004" as="sourcePoint"/>
                        <mxPoint x="1212" y="269.58000000000004" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="ODITfQRj00F-9atufKFF-71" value="Evidence Kill Time" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" parent="ODITfQRj00F-9atufKFF-70" vertex="1" connectable="0">
                    <mxGeometry x="-0.091" relative="1" as="geometry">
                        <mxPoint x="3" y="-10" as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="ODITfQRj00F-9atufKFF-72" value="" style="endArrow=none;html=1;" parent="ODITfQRj00F-9atufKFF-27" edge="1">
                    <mxGeometry width="50" height="50" relative="1" as="geometry">
                        <mxPoint x="1490" y="210" as="sourcePoint"/>
                        <mxPoint x="1489.1470570554266" y="350.00036069285125" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="ODITfQRj00F-9atufKFF-78" value="Evidence Submission Time" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="ODITfQRj00F-9atufKFF-27" vertex="1">
                    <mxGeometry x="990" y="340" width="190" height="210" as="geometry">
                        <mxRectangle x="50" y="140" width="70" height="30" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="ODITfQRj00F-9atufKFF-79" value="The first dispute that hits the chain for a given fork creates the DisputeWindow, which starts the Evidene Submission Time. &lt;br&gt;This is the time window, other peers have to submit their evidence (dispute perception). Disputes can come randomly, in any order or may not come at all, but they must come within this time or they won&#39;t be included." style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" parent="ODITfQRj00F-9atufKFF-78" vertex="1">
                    <mxGeometry y="30" width="190" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="ODITfQRj00F-9atufKFF-80" value="Evidence Kill Time" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="ODITfQRj00F-9atufKFF-27" vertex="1">
                    <mxGeometry x="1190" y="330" width="280" height="290" as="geometry">
                        <mxRectangle x="50" y="140" width="70" height="30" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="ODITfQRj00F-9atufKFF-81" value="There&#39;s a chance that the evidence(dispute) submitted is &lt;b&gt;fradulent&lt;/b&gt;. Such disputes should be killed/removed and their submitters slashed. This is done with &lt;b&gt;DisputeFraudProofs&lt;/b&gt; or explitic dispute &lt;b&gt;auditing&lt;/b&gt;. This is detected in the &lt;b&gt;Dispute Validation Pipeline&lt;/b&gt;, once peers become aware of a dispute that&#39;s commited on-chain. By killing the dispute, it&#39;s removed from evidence and not taken into account in &lt;b&gt;reduce&lt;/b&gt;. The kill time is longer than the evidence submission time to allow disputes that are submitted at the end of the evidence submission time to still be detected and potentially killed.&amp;nbsp;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" parent="ODITfQRj00F-9atufKFF-80" vertex="1">
                    <mxGeometry y="30" width="280" height="260" as="geometry"/>
                </mxCell>
                <mxCell id="ODITfQRj00F-9atufKFF-82" value="Reduce Challenge Time" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="ODITfQRj00F-9atufKFF-27" vertex="1">
                    <mxGeometry x="1620" y="360" width="230" height="360" as="geometry">
                        <mxRectangle x="50" y="140" width="70" height="30" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="ODITfQRj00F-9atufKFF-83" value="Since most blockchains are event driven (a transaction has to happen to update/mutate the state), the reduced result is NOT computed automatically when the Evidence Kill Time expires. An external event/transaction has to initiate the computation. It can be done in 2 ways:&lt;br&gt;1) By explicitly running reduce any time after the Evidence Kill Time expires for the given DisputeWindow, which &lt;b&gt;commits and finalizes&lt;/b&gt; the reduce result. This can not be challenged but the computation has been verifed/done on-chain. Instalty final.&lt;br&gt;2) Optimistically commiting to the reduced result and allowing it to be challenged during the &lt;b&gt;Reduce Challenge Time&lt;/b&gt;&lt;br&gt;&lt;br&gt;Allowing to pay&amp;nbsp;&lt;b&gt;in gas&lt;/b&gt; (fees) (1) or &lt;b&gt;in time&lt;/b&gt; (2)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" parent="ODITfQRj00F-9atufKFF-82" vertex="1">
                    <mxGeometry y="30" width="230" height="330" as="geometry"/>
                </mxCell>
                <mxCell id="ODITfQRj00F-9atufKFF-84" value="" style="endArrow=none;html=1;" parent="ODITfQRj00F-9atufKFF-27" edge="1">
                    <mxGeometry width="50" height="50" relative="1" as="geometry">
                        <mxPoint x="1632.43" y="210" as="sourcePoint"/>
                        <mxPoint x="1631.5770570554266" y="350.00036069285125" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
