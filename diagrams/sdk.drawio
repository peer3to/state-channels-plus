                    </mxGeometry>
                </mxCell>
                <mxCell id="3C9OKIPbisEUVXZUuXrE-11" value="ATransport is a transport abstraction - cocnrete instances are &lt;b&gt;WebRTC&lt;/b&gt; and &lt;b&gt;Holepunch&lt;/b&gt; wich both provide a &#39;&lt;b&gt;socket like&lt;/b&gt;&#39; transport layer for bidirectional real-time comunication between peers.&amp;nbsp;&lt;br&gt;&lt;br&gt;Specifically the &#39;&lt;b&gt;onMessage&lt;/b&gt;&#39; is triggered here which is in the form of a &lt;b&gt;serlized RPC. &lt;/b&gt;All peer-to-peer comunication is done via RPCs and if a peer fails to follow the protocol and sends something that&#39;s not supported, the receving peer will abort the message and close the connection/transport to the malicious peer." style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" parent="3C9OKIPbisEUVXZUuXrE-10" vertex="1">
                    <mxGeometry y="30" width="140" height="390" as="geometry"/>
                </mxCell>
                <mxCell id="3C9OKIPbisEUVXZUuXrE-33" value="Blockchain part" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;recursiveResize=0;container=1;collapsible=0;width=160;fillColor=#d5e8d4;strokeColor=#82b366;" parent="ac9qXiK-3Fl4joFTNuty-2" vertex="1">
                    <mxGeometry x="640" y="20" width="310" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="3C9OKIPbisEUVXZUuXrE-34" value="Note" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="ac9qXiK-3Fl4joFTNuty-2" vertex="1" collapsed="1">
                    <mxGeometry x="370" y="290" width="70" height="30" as="geometry">
                        <mxRectangle x="370" y="290" width="140" height="200" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="3C9OKIPbisEUVXZUuXrE-35" value="The p2pManager deserializes the serilized RPC mesage and pases it to the appropriate RPC component - if succesfull - otherwise it drops the message and disconnects from the peer" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" parent="3C9OKIPbisEUVXZUuXrE-34" vertex="1">
                    <mxGeometry y="30" width="140" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="3C9OKIPbisEUVXZUuXrE-36" value="Note" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="ac9qXiK-3Fl4joFTNuty-2" vertex="1" collapsed="1">
                    <mxGeometry x="1060" y="20" width="70" height="30" as="geometry">
                        <mxRectangle x="1060" y="20" width="140" height="200" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="3C9OKIPbisEUVXZUuXrE-37" value="The DLT emits a &lt;b&gt;SignedBlock&lt;/b&gt; - a SignedBlock is wrapped into a &lt;b&gt;BlockConfirmation&lt;/b&gt; and passed to the StateManager" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" parent="3C9OKIPbisEUVXZUuXrE-36" vertex="1">
                    <mxGeometry y="30" width="140" height="170" as="geometry"/>
                </mxCell>
