                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="7IE0TgfvVyxq2MSAQDQT-50" value="SharedCoordinator" style="html=1;whiteSpace=wrap;" parent="7IE0TgfvVyxq2MSAQDQT-48" vertex="1">
                    <mxGeometry x="570" y="70" width="110" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="7IE0TgfvVyxq2MSAQDQT-58" style="edgeStyle=none;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="7IE0TgfvVyxq2MSAQDQT-48" source="7IE0TgfvVyxq2MSAQDQT-51" target="7IE0TgfvVyxq2MSAQDQT-50" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="7IE0TgfvVyxq2MSAQDQT-51" value="C" style="html=1;whiteSpace=wrap;" parent="7IE0TgfvVyxq2MSAQDQT-48" vertex="1">
                    <mxGeometry x="700" y="200" width="110" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="7IE0TgfvVyxq2MSAQDQT-56" style="edgeStyle=none;html=1;exitX=0.25;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" parent="7IE0TgfvVyxq2MSAQDQT-48" source="7IE0TgfvVyxq2MSAQDQT-52" target="7IE0TgfvVyxq2MSAQDQT-50" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="7IE0TgfvVyxq2MSAQDQT-52" value="B" style="html=1;whiteSpace=wrap;" parent="7IE0TgfvVyxq2MSAQDQT-48" vertex="1">
                    <mxGeometry x="570" y="200" width="110" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="7IE0TgfvVyxq2MSAQDQT-60" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;Shared Coordinator&lt;br&gt;&lt;span style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;The &lt;/span&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;dependency graph&lt;/span&gt;&lt;span style=&quot;font-size: 12px; font-weight: 400;&quot;&gt; above depicts the &lt;/span&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;actual dependencies&lt;/span&gt;&lt;span style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;. All components are &lt;/span&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;logically signletons&lt;/span&gt;&lt;span style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;, but we don&#39;t want to use the singleton pattern since it makes the software hard to test (dependency injection withouth including &#39;mock&#39; code in source code, parallel/concurrent test would also break due to shared global reference across all tests) and in general if we wanted to run multiple instances of the system in the same memory context, we couldn&#39;t. The alternative solution, if we wanted a &lt;/span&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&#39;singleton like&#39;&lt;/span&gt;&lt;span style=&quot;font-size: 12px; font-weight: 400;&quot;&gt; experinece (&lt;/span&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;not passing all references everywhere&lt;/span&gt;&lt;span style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;), is to use a central coordination compontent. The &lt;/span&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;SharedCoordinator&lt;/span&gt;&lt;span style=&quot;font-size: 12px; font-weight: 400;&quot;&gt; is a normal object (not a singleton) which is created at &lt;/span&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;setup&lt;/span&gt;&lt;span style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;&amp;nbsp;and it creates all other &#39;singleton like objects&#39; (following the rules of the dependency graph) with a &lt;/span&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;bidiredctional reference&lt;/span&gt;&lt;span style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;&amp;nbsp;to every object (every object has a reference to the SharedCoordinator and the SharedCoordinator has a reference to every object) meaning that every &#39;singleton like&#39; object can be reached through the SharedCoordinator. This way in tests we only need to do dependency injections in the SharedCoordinator and all the memory stays seperated, so we could run tests in parrallel and instantiate multiple instances of the system in the same process. All without introducing any &#39;mock&#39; stuff in the source code or having any global references.&lt;/span&gt;&lt;/span&gt;&lt;/h1&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="7IE0TgfvVyxq2MSAQDQT-48" vertex="1">
                    <mxGeometry x="20" y="80" width="410" height="610" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
