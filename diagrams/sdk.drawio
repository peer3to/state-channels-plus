                    <mxGeometry x="490" y="154" width="120" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="04kf31U29QvEIDmgyHl--4" value="onChainSlashes[ ]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="MiHG-ok4c3-oJHMUXmo7-1" vertex="1">
