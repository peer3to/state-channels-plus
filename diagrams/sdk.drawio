                </mxCell>
                <mxCell id="TrUzMLvp8-iy_VfnUbSl-11" value="Note" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="yCVjHuBSaaYtSWHuKgmm-1" vertex="1">
                    <mxGeometry x="380" y="400" width="220" height="170" as="geometry">
