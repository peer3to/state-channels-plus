                    </mxGeometry>
                </mxCell>
                <mxCell id="RnoZjXUfups5RpbPsFKl-4" value="successCallback() returned from the StateTransition - mostly just emits logs/events and anything that should wait for all the checks to conclude succesfully before notifying the user that the state transition happened.&amp;nbsp;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" parent="RnoZjXUfups5RpbPsFKl-3" vertex="1">
