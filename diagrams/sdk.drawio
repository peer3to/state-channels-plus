                <mxCell id="2Vz3iMNDl8VetjiaL6hz-15" value="Building on the wrong genesisSnapshot for a forkId is objective deviation and all the Data is Available -&amp;gt; fraud proof&lt;br&gt;&lt;br&gt;A forkId uniquly and unambiguously defines StateSnapshotData with everything else being implicit and objective to how the SnapshotData was derived on-chain (genesisTimestamp == DisputeWindow.genesisTimestamp, snapshot.forkId = hash(SnapshotData), snapshot.height = 0)&amp;nbsp;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" parent="2Vz3iMNDl8VetjiaL6hz-14" vertex="1">
                    <mxGeometry y="30" width="350" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="Tkg7loyrQP702Ur1c9dN-220" value="Think(LatestState in Disputes)" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="-826" y="2420" width="220" height="250" as="geometry">
                        <mxRectangle x="90" y="1385" width="120" height="30" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="Tkg7loyrQP702Ur1c9dN-221" value="A double sign happened for sure, but what do we pick as the latest state when creating a dispute? What&#39;s the canonical reality.&lt;br&gt;&lt;br&gt;This is more theoretical than practical - still need to think it through&amp;nbsp;&lt;br&gt;-----------------------&lt;br&gt;The longest!&lt;br&gt;Building on 2 diferent realities will slash you - the longest chain wins and in the case of a tie the &lt;strike&gt;first dispute&lt;/strike&gt; lower forkId, since reduce is sequential" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" parent="Tkg7loyrQP702Ur1c9dN-220" vertex="1">
                    <mxGeometry y="30" width="220" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="LOWv3ICWzKBFDTG-m15R-1" value="Think(in chain vs in queue)" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" collapsed="1" vertex="1">
                    <mxGeometry x="50" y="1558" width="174" height="30" as="geometry">
                        <mxRectangle x="50" y="1558" width="180" height="160" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="LOWv3ICWzKBFDTG-m15R-2" value="Doesn&#39;t need any special case for &#39;in-chain&#39; vs &#39;in queue&#39; as long as the isParticiapnt check can correcty check the signatures before persiting them in the coresponing data strucutre BlockStorage(in-chain) / queue&amp;nbsp;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" parent="LOWv3ICWzKBFDTG-m15R-1" vertex="1">
