                    <mxGeometry x="280" y="880" width="140" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="Tkg7loyrQP702Ur1c9dN-273" value="&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;return NOT_ENOUGH_TIME&lt;/span&gt;" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.terminator;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="Tkg7loyrQP702Ur1c9dN-267" vertex="1">
                    <mxGeometry x="280" y="1680" width="140" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="Tkg7loyrQP702Ur1c9dN-274" value="&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;return DISCONNECT&lt;/span&gt;" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.terminator;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="Tkg7loyrQP702Ur1c9dN-267" vertex="1">
                    <mxGeometry x="280" y="640" width="140" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="Tkg7loyrQP702Ur1c9dN-275" value="&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;return NOT_READY&lt;/span&gt;" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.terminator;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="Tkg7loyrQP702Ur1c9dN-267" vertex="1">
                    <mxGeometry x="290" y="440" width="140" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="Tkg7loyrQP702Ur1c9dN-276" value="&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;return BROADCAST&lt;/span&gt;" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.terminator;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="Tkg7loyrQP702Ur1c9dN-267" vertex="1">
                    <mxGeometry x="280" y="1480" width="140" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="Tkg7loyrQP702Ur1c9dN-277" value="Note" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="Tkg7loyrQP702Ur1c9dN-267" vertex="1">
                    <mxGeometry x="10" y="210" width="260" height="190" as="geometry">
                        <mxRectangle x="90" y="210" width="70" height="30" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="Tkg7loyrQP702Ur1c9dN-278" value="&lt;b&gt;Meaning&lt;/b&gt;:&lt;br&gt;BlockConfirmation pipeline was executed succesfully - the block was applied to the state.&lt;br&gt;&lt;br&gt;&lt;b&gt;RPC&lt;/b&gt;: doesn&#39;t do anything. The BlockConfirmation will be expanded with the new signature and the new BlockConfirmation (a super set) will be gossiped. This is initiated from the StateManager.&lt;br&gt;&amp;nbsp;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" parent="Tkg7loyrQP702Ur1c9dN-277" vertex="1">
                    <mxGeometry y="30" width="260" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="Tkg7loyrQP702Ur1c9dN-280" value="Validation Flags are generated by the &lt;b&gt;StateManager &lt;/b&gt;and returned to the &lt;b&gt;StateTransitionRPC(p2pManager)&lt;/b&gt;&amp;nbsp;so the P2PManager knows what to do with the BlockCondirmation (RPC message) without interpreting it&amp;nbsp;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="Tkg7loyrQP702Ur1c9dN-267" vertex="1">
                    <mxGeometry x="70" y="60" width="400" height="71" as="geometry"/>
                </mxCell>
                <mxCell id="Tkg7loyrQP702Ur1c9dN-281" value="Note" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="Tkg7loyrQP702Ur1c9dN-267" vertex="1">
                    <mxGeometry x="10" y="440" width="260" height="170" as="geometry">
                        <mxRectangle x="50" y="440" width="70" height="30" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="Tkg7loyrQP702Ur1c9dN-282" value="&lt;b&gt;Meaning&lt;/b&gt;:&lt;br&gt;BlockConfirmation is queued since it&#39;s not part of the canonical chain and can not be applied to the current state.&lt;br&gt;&lt;br&gt;&lt;b&gt;RPC&lt;/b&gt;: doesn&#39;t do anything, but should consider disconnecting in some cases - queue spam prevention mechanism yet to be designed.&lt;br&gt;&amp;nbsp;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" parent="Tkg7loyrQP702Ur1c9dN-281" vertex="1">
                    <mxGeometry y="30" width="260" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="Tkg7loyrQP702Ur1c9dN-283" value="Note" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="Tkg7loyrQP702Ur1c9dN-267" vertex="1">
                    <mxGeometry x="10" y="640" width="260" height="210" as="geometry">
                        <mxRectangle x="90" y="210" width="70" height="30" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="Tkg7loyrQP702Ur1c9dN-284" value="&lt;b&gt;Meaning&lt;/b&gt;:&lt;br&gt;BlockConfirmation is junk/spam. Can&#39;t prove objective byzantine behaviour from a participant in the channel. Kill the connection that sent the message and blacklist the peer.&lt;br&gt;&lt;br&gt;&lt;b&gt;RPC&lt;/b&gt;: Disconnects/kills the connection and blacklists the peer, so future connections are not established. Does NOT gossip the message, since we&#39;d be blacklisted too, but later (V2) we can explore ways to share opinions (web of trust)&amp;nbsp;&lt;br&gt;&amp;nbsp;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" parent="Tkg7loyrQP702Ur1c9dN-283" vertex="1">
                    <mxGeometry y="30" width="260" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="Tkg7loyrQP702Ur1c9dN-286" value="Note" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="Tkg7loyrQP702Ur1c9dN-267" vertex="1">
                    <mxGeometry x="10" y="880" width="260" height="550" as="geometry">
                        <mxRectangle x="90" y="210" width="70" height="30" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="Tkg7loyrQP702Ur1c9dN-287" value="&lt;b&gt;Meaning&lt;/b&gt;:&lt;br&gt;BlockConfirmation is malicious and we can prove fraud originated from someone in the channel. Kill this connection and kill the connection of the byzantine peer that (if available - done by the StateManager) .Do NOT gosspit the original message - create a dispute and gossip the DISPUTE!&amp;nbsp;&lt;br&gt;&lt;br&gt;&lt;b&gt;RPC&lt;/b&gt;: Kill the original connection and blacklist the peer. The StateManager will try and kill the connection to the byzantine peer if available.&amp;nbsp;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;More context on why the above was designed the way it is:&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Idealy everyone disconnects from the byzatine peer once they detect it, but that may not be the case - The byzantine peer may continue to share byzantine messages through other peers, and since other peers are &#39;sharing information&#39; they will spam with information we don&#39;t need -&amp;gt; This flag on it&#39;s own should NOT gossip the origianl message, but for collecting fraud proofs we can share DISPUTES over RPC as we create them on-chain OR we don&#39;t even have to do that over RPC, since when the dispute is created on-chain it&#39;s emitted as calldata and that triggers others to provide their local perception of the dispute, but maybe still better to do it over RPC in PARALLEL since it&#39;s faster and others can also initiate a dispute in prallel and hopefully instantnly REDUCE.&lt;br&gt;&amp;nbsp;&lt;/div&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" parent="Tkg7loyrQP702Ur1c9dN-286" vertex="1">
                    <mxGeometry y="30" width="260" height="520" as="geometry"/>
                </mxCell>
                <mxCell id="Tkg7loyrQP702Ur1c9dN-288" value="Note" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="Tkg7loyrQP702Ur1c9dN-267" vertex="1">
                    <mxGeometry x="10" y="1480" width="260" height="190" as="geometry">
                        <mxRectangle x="90" y="210" width="70" height="30" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="Tkg7loyrQP702Ur1c9dN-289" value="&lt;b&gt;Meaning&lt;/b&gt;:&lt;br&gt;BlockConfirmation is valid and it was already applied to the state, but it contains more signatures, so gossip the original message without modifying it.&lt;br&gt;&lt;br&gt;&lt;b&gt;RPC&lt;/b&gt;: Doesn&#39;t do anything just gossips the message - The stateManager can also initaite that. So this doesn&#39;t have to do anything.&amp;nbsp;&lt;br&gt;&amp;nbsp;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" parent="Tkg7loyrQP702Ur1c9dN-288" vertex="1">
                    <mxGeometry y="30" width="260" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="Tkg7loyrQP702Ur1c9dN-290" value="Note" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="Tkg7loyrQP702Ur1c9dN-267" vertex="1">
                    <mxGeometry x="10" y="1680" width="260" height="240" as="geometry">
                        <mxRectangle x="90" y="210" width="70" height="30" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="Tkg7loyrQP702Ur1c9dN-291" value="&lt;b&gt;Meaning&lt;/b&gt;:&lt;br&gt;BlockConfirmation is valid and it should be applied to the current state, but the subjective time check failed. Abstain from applying it to the state and don&#39;t sign the confirmation. This will force the block autor to post the block as calldata which will override the timestamp with the on-chain one and as a result there will be enought time. If that&#39;s not the case, trigger timeout after the time expires.&amp;nbsp;&lt;br&gt;&lt;br&gt;&lt;b&gt;RPC&lt;/b&gt;: Doesn&#39;t do anything.&amp;nbsp;&lt;br&gt;&amp;nbsp;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" parent="Tkg7loyrQP702Ur1c9dN-290" vertex="1">
                    <mxGeometry y="30" width="260" height="210" as="geometry"/>
                </mxCell>
                <mxCell id="Tkg7loyrQP702Ur1c9dN-292" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;color: rgb(0, 204, 102);&quot;&gt;CONCLUSION&lt;/font&gt;&lt;/h1&gt;&lt;p&gt;After going over what each flag does and means we come to a conclusion they&#39;re not needed! Originally they we&#39;re desgined to pass more information back to the RPC/P2PManager so the calling context has more information on what to do, but the only decision that the calling context (RPC/P2PManager) do is decide do they disconnect the soccet and blacklist the peer or not - so the return value can just be &#39;shouldDisconnect&#39; and everything else can be initiated by the StateManager so these &#39;flags&#39; can become private helper functions of the validation pipeline: success(), notReady()...&amp;nbsp;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="Tkg7loyrQP702Ur1c9dN-267" vertex="1">
                    <mxGeometry x="520" y="200" width="180" height="370" as="geometry"/>
                </mxCell>
