                <mxCell id="-MXcLcMf_BDdAfsZCEQr-12" value="&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;font&gt;persist &lt;b style=&quot;&quot;&gt;InvalidTimestamp&lt;/b&gt;&lt;/font&gt;&lt;b style=&quot;&quot;&gt;&amp;nbsp;&lt;/b&gt;&lt;font&gt;fraud proof&lt;/font&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="-MXcLcMf_BDdAfsZCEQr-1" vertex="1">
