                <mxCell id="Tkg7loyrQP702Ur1c9dN-259" value="Returns&lt;div&gt;- &lt;b&gt;success&lt;/b&gt;&lt;/div&gt;&lt;div&gt;- &lt;b&gt;successCallback &lt;/b&gt;- called at the end of the pipeline - emts logs and displays to the users that the operation was successfull - mostly there so we don&#39;t diplay the transition if the rest of the pipeline fails&lt;/div&gt;&lt;div&gt;- &lt;b&gt;exitChannels &lt;/b&gt;- any exits that happen as a byproduct of the state transition&amp;nbsp;&amp;nbsp;&lt;/div&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" parent="Tkg7loyrQP702Ur1c9dN-258" vertex="1">
                    <mxGeometry y="30" width="290" height="140" as="geometry"/>
                </mxCell>
