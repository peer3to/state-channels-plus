                <mxCell id="Tkg7loyrQP702Ur1c9dN-92" value="&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;If (isBlockDuplicate) -&amp;gt; this covers all correct past blocks that we&#39;ve proccesed&amp;nbsp;&lt;/font&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" parent="Tkg7loyrQP702Ur1c9dN-91" vertex="1">
