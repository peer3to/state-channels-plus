                <mxCell id="TrUzMLvp8-iy_VfnUbSl-2" value="There are others but these are all the external ones (for now) - other are internal (called by the system)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" parent="TrUzMLvp8-iy_VfnUbSl-1" vertex="1">
