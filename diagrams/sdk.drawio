                    </mxGeometry>
                </mxCell>
                <mxCell id="RnoZjXUfups5RpbPsFKl-2" value="if I performed a full exit (not part of the participant set anymore ) -&amp;gt; wait agreementTime to try and reach N/N threshld on the BlockConfirmation and &lt;br&gt;&lt;br&gt;&lt;b&gt;if (success)&lt;/b&gt;: update the snapshot with the BlockConfirmation proving the latest state to exit on-chain and process withdrawals&lt;br&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;else(failure)&lt;/b&gt;: create a dispute with the BlockConfirmation set as the latest state and selfRemoval flag set to true&lt;/div&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" parent="RnoZjXUfups5RpbPsFKl-1" vertex="1">
                    <mxGeometry y="30" width="200" height="270" as="geometry"/>
                </mxCell>
