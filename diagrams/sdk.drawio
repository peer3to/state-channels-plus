                </mxCell>
                <mxCell id="7IE0TgfvVyxq2MSAQDQT-39" value="Currently only the StateManager and RPC use this, but in general as we conclude the SDK all components should have their own deidcated hooks to triger so this component will be refrenced by all components more or less" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="7IE0TgfvVyxq2MSAQDQT-38">
                    <mxGeometry y="30" width="140" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="7IE0TgfvVyxq2MSAQDQT-42" value="Note" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" collapsed="1" parent="1">
                    <mxGeometry x="730" y="340" width="70" height="30" as="geometry">
                        <mxRectangle x="730" y="340" width="140" height="180" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="7IE0TgfvVyxq2MSAQDQT-43" value="Not sure is this component needed (mostly some helper functions) - will leave it here for now and see later does it make sense to be a seperate component or not" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="7IE0TgfvVyxq2MSAQDQT-42">
                    <mxGeometry y="30" width="140" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="7IE0TgfvVyxq2MSAQDQT-45" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b style=&quot;&quot;&gt;All Components&lt;/b&gt; in the dependency graph have a &lt;b style=&quot;&quot;&gt;single instance&lt;/b&gt; -&amp;gt; are efectively a &lt;b style=&quot;&quot;&gt;singleton logically&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
                    <mxGeometry x="-425" y="360" width="225" height="160" as="geometry"/>
