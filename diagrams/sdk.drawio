                <mxCell id="6_6lAV-Iw7Cl6SVSdu1H-3" value="Like Dispute Fraud Proofs - these operate like statefull proofs, since some are statefull (require reading on-chain storage during execution) so we unify the pipeline" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="6_6lAV-Iw7Cl6SVSdu1H-2">
