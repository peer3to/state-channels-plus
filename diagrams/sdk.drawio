                <mxCell id="3C9OKIPbisEUVXZUuXrE-10" value="Note" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="ac9qXiK-3Fl4joFTNuty-2" vertex="1" collapsed="1">
