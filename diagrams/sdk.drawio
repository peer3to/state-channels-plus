                <mxCell id="Tkg7loyrQP702Ur1c9dN-219" value="Canonical" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;recursiveResize=0;container=1;collapsible=0;width=160;" parent="Tkg7loyrQP702Ur1c9dN-205" vertex="1">
