                <mxCell id="1" parent="0"/>
                <mxCell id="ac9qXiK-3Fl4joFTNuty-1" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Lifecycle of External Messages&lt;/h1&gt;&lt;p&gt;&quot;Messages&quot; are fed into the system from either:&lt;br&gt;1) The p2p network&lt;br&gt;2) The DLT (blockchain)&lt;br&gt;Here we&#39;ll anaylize the typical lifescylce/pipeline for some of our most important message types&amp;nbsp;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
