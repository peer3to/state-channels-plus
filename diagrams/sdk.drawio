                    </mxGeometry>
                </mxCell>
                <mxCell id="TrUzMLvp8-iy_VfnUbSl-12" value="&lt;b&gt;P2P Contact Instance&lt;/b&gt; and &lt;b&gt;P2PSigner&lt;/b&gt; are used by the user to explicitly interact with the SDK - so they&#39;re &#39;&lt;b&gt;action&lt;/b&gt;&#39; triggers/entry points and the&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;RPC&lt;/b&gt; and &lt;b&gt;BlockchainEvents&lt;/b&gt; are implicit &#39;&lt;b&gt;reaction&lt;/b&gt;&#39; entry points (the end user doesn&#39;t interact with them directly)&amp;nbsp;&lt;/div&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" parent="TrUzMLvp8-iy_VfnUbSl-11" vertex="1">
