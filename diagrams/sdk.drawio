                <mxCell id="KeMdtG4UYb00cbbnajk4-1" value="onDisputeAuditingDataPosted -&amp;gt; rename -&amp;gt; onDisputeCommittedWithAuditingData" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;recursiveResize=0;container=1;collapsible=0;width=480;height=51;" parent="1" vertex="1">
