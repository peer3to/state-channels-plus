                </mxCell>
                <mxCell id="oNWmNa7ofPwur-fx96nA-8" value="&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;authenticateInvalidBlock &lt;/font&gt;&lt;font style=&quot;color: rgb(0, 153, 77);&quot;&gt;// signed by block author&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;if(invalidBlock.height == 0) {&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;font style=&quot;color: rgb(0, 0, 0); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;require(invalidBlock.previousBlockHash = hash(previousStateSnapshot)&lt;/font&gt;&lt;span style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); color: rgb(63, 63, 63);&quot;&gt;&lt;font style=&quot;color: rgb(0, 153, 77);&quot;&gt;// Don&#39;t need to prove it&#39;s the actual snapshot, the author commited to it and if it&#39;s not we&#39;d call WrongGenesis on the block&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;previousTimestamp = previousSnapshot.timestamp&lt;/font&gt;&lt;/div&gt;&lt;div&gt;}else{&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;require(invalidBlock.previousBlockHash = hash(previousBlock)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;previousAuthor = previousBlock.author&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 153, 77);&quot;&gt;//check if calldata is posted&amp;nbsp;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;committment = calldata[forkId][previousBlock.height][previousAuthor]&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;font color=&quot;#000000&quot;&gt;if(committment){&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;require(committment = hash(previousBlockCalldata, previousBlockOnChainTimestamp)&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;if(previousBlockCalldata != previousBlock || authorSignedPreviousBlock) previousTimestamp = previousBlock.timestamp&lt;br&gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;else previousTimestamp = previousBlockOnChainTimestamp&lt;br&gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;}&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;else previousTimestamp = previousBlock.timestamp&lt;/font&gt;&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;currentBlockCommitment = calldata[forkId][invalidBlock.height][invalidBlock.author]&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 153, 77);&quot;&gt;// currentBlockTimestamp = (currentBlockCommitment &amp;amp;&amp;amp; hash(InvalidBlock,InvalidBlockOnChainTimestamp) == currentBlockCommittment ) ? invalidBlockOnChainTimestamp : invalidBlock.timestamp&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;p style=&quot;margin-top: 0px; margin-bottom: 0px;&quot; class=&quot;pf0&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;&quot; class=&quot;cf0&quot;&gt;if(&lt;/span&gt;&lt;span style=&quot;&quot; class=&quot;cf0&quot;&gt;currentBlockCommitment&lt;/span&gt;&lt;span style=&quot;&quot; class=&quot;cf0&quot;&gt;){&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;font&gt;&lt;p style=&quot;margin-top: 0px; margin-left: 0px; margin-bottom: 0px;&quot; class=&quot;pf0&quot;&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot; class=&quot;cf0&quot;&gt;    require(&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot; class=&quot;cf0&quot;&gt;currentBlockCommitment&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot; class=&quot;cf0&quot;&gt; = hash(&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot; class=&quot;cf0&quot;&gt;currentBlockCalldata&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot; class=&quot;cf0&quot;&gt;, &lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot; class=&quot;cf0&quot;&gt;invalidBlockOnChainTimestamp&lt;/span&gt;&lt;span style=&quot;&quot; class=&quot;cf0&quot;&gt;&lt;font style=&quot;color: rgb(0, 153, 77);&quot;&gt;)) // if this doesn&#39;t hold punish the disputer since they didn&#39;t supply correct data&lt;/font&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin-top: 0px; margin-bottom: 0px;&quot; class=&quot;pf0&quot;&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot; class=&quot;cf0&quot;&gt;    if(&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot; class=&quot;cf0&quot;&gt;currentBlockCalldata&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot; class=&quot;cf0&quot;&gt; != &lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot; class=&quot;cf0&quot;&gt;invalidBlock&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot; class=&quot;cf0&quot;&gt;)return &lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot; class=&quot;cf0&quot;&gt;invalidAuthorAddress&lt;/span&gt;&lt;span style=&quot;&quot; class=&quot;cf0&quot;&gt; &lt;font style=&quot;color: light-dark(rgb(0, 153, 77), rgb(237, 237, 237));&quot;&gt;// the author &lt;/font&gt;&lt;/span&gt;&lt;font&gt;&lt;span style=&quot;&quot; class=&quot;cf0&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 153, 77), rgb(237, 237, 237));&quot;&gt;commited&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 153, 77), rgb(237, 237, 237));&quot; class=&quot;cf0&quot;&gt; to some junk or another block, but still produced and signed &lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 153, 77), rgb(237, 237, 237));&quot; class=&quot;cf0&quot;&gt;invalidBlock&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin-top: 0px; margin-bottom: 0px;&quot; class=&quot;pf0&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&lt;span style=&quot;&quot; class=&quot;cf0&quot;&gt;    &lt;/span&gt;&lt;span style=&quot;&quot; class=&quot;cf0&quot;&gt;currentBlockTimestamp&lt;/span&gt;&lt;span style=&quot;&quot; class=&quot;cf0&quot;&gt; = &lt;/span&gt;&lt;span style=&quot;&quot; class=&quot;cf0&quot;&gt;invalidBlockOnChainTimestamp&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); margin-top: 0px;&quot; class=&quot;pf0&quot;&gt;&lt;span style=&quot;&quot; class=&quot;cf0&quot;&gt;}&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;require(invalidBlock.timestamp &amp;gt;= previousTimestamp)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;require(invalidBlock.timestamp &amp;lt;= previousTimestamp + p2pTime)&lt;/font&gt; &lt;font style=&quot;color: rgb(0, 153, 77);&quot;&gt;//&lt;/font&gt; &lt;font style=&quot;color: rgb(0, 153, 77);&quot;&gt;p2pTime should be changed later with getP2pTime(previousStateSnapshot.stateMachineState)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#00994d&quot;&gt;&lt;b&gt;require(currentBlockTimestamp &amp;lt;= previousTimestamp + p2pTime + agreementTime + chainFallbackTime)&amp;nbsp;&lt;/b&gt;&lt;br&gt;&lt;/font&gt;&lt;br&gt;&lt;/div&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" parent="oNWmNa7ofPwur-fx96nA-7" vertex="1">
                    <mxGeometry y="30" width="1090" height="560" as="geometry"/>
                </mxCell>
