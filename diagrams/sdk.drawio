                    <mxGeometry x="105" y="220" width="150" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="Tkg7loyrQP702Ur1c9dN-258" value="Note" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="Tkg7loyrQP702Ur1c9dN-238" vertex="1">
                    <mxGeometry x="296" y="210" width="290" height="170" as="geometry">
