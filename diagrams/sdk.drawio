                <mxCell id="3C9OKIPbisEUVXZUuXrE-32" value="P2P part" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;recursiveResize=0;container=1;collapsible=0;width=160;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="ac9qXiK-3Fl4joFTNuty-2" vertex="1">
