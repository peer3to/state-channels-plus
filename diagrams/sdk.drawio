                <mxCell id="Tkg7loyrQP702Ur1c9dN-267" value="Validation Flags (BlockConfirmation)" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;recursiveResize=0;container=1;collapsible=0;width=160;" parent="1" vertex="1">
                    <mxGeometry x="1888" y="1200" width="770" height="2000" as="geometry"/>
                </mxCell>
                <mxCell id="Tkg7loyrQP702Ur1c9dN-270" value="&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;return SUCCESS&lt;/span&gt;" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.terminator;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="Tkg7loyrQP702Ur1c9dN-267" vertex="1">
