                    </mxGeometry>
                </mxCell>
                <mxCell id="RnoZjXUfups5RpbPsFKl-16" value="&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;if the block is posted on-chain and I&#39;m next - abstain from sigining (so I don&#39;t forfeit my right to more time)&amp;nbsp;&lt;br&gt;&lt;/span&gt;&lt;br&gt;If the block author is blacklisted, abstain from signing&lt;br&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;Always broadcast, regardless.&amp;nbsp;&lt;/span&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" parent="RnoZjXUfups5RpbPsFKl-15" vertex="1">
                    <mxGeometry y="30" width="240" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="RnoZjXUfups5RpbPsFKl-17" value="Note" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="3C9OKIPbisEUVXZUuXrE-42" vertex="1">
                    <mxGeometry x="477" y="3354" width="249" height="390" as="geometry">
                        <mxRectangle x="50" y="140" width="70" height="30" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="RnoZjXUfups5RpbPsFKl-18" value="start timer to timeout next participant.&amp;nbsp;&lt;br&gt;&lt;br&gt;wait p2pTime + agreementTime + ChainFallbackTime&lt;br&gt;&lt;br&gt;After, check did you confirm the block - if you did - return&lt;br&gt;&lt;br&gt;Check is the block posted on-chain - if it is, return&amp;nbsp;&lt;br&gt;&lt;br&gt;check is the previous block posted on-chain - if it&#39;s not timeout the next participat&amp;nbsp;&lt;br&gt;&lt;br&gt;if it is, check did the next participant sign the previous block, if they did, time them out (they don&#39;t have extra time)&amp;nbsp;&lt;br&gt;&lt;br&gt;if they did NOT, sleep for another (block.onChainTimestamp - block.timestamp) and check did the next participant produce a block and if they didn&#39;t time them out&amp;nbsp;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" parent="RnoZjXUfups5RpbPsFKl-17" vertex="1">
                    <mxGeometry y="30" width="249" height="360" as="geometry"/>
                </mxCell>
                <mxCell id="RnoZjXUfups5RpbPsFKl-23" style="edgeStyle=none;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" parent="3C9OKIPbisEUVXZUuXrE-42" source="Tkg7loyrQP702Ur1c9dN-305" target="Tkg7loyrQP702Ur1c9dN-185" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="RnoZjXUfups5RpbPsFKl-24" value="Think (Timeout)" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="3C9OKIPbisEUVXZUuXrE-42" vertex="1">
                    <mxGeometry x="230" y="3464" width="215" height="270" as="geometry">
                        <mxRectangle x="120" y="500" width="70" height="30" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="RnoZjXUfups5RpbPsFKl-25" value="Expand disputes.timeout with an optional fiield - signature of the previous block&lt;br&gt;&lt;br&gt;So if the previous block is posted on-chain and the timeout field includes a valid siganture from the person being timedout confirming it, it doesn&#39;t rebase the timestamp if someone wants to contest it with `TimeoutTooEarly`&lt;br&gt;&lt;br&gt;DisputeWindow creation timestamp is shared for all disputes and is used as the timeout timestamp in the comparison&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" parent="RnoZjXUfups5RpbPsFKl-24" vertex="1">
