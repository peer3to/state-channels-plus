                </mxCell>
                <mxCell id="-MXcLcMf_BDdAfsZCEQr-63" value="When a block is posted on-chain it has to be posted before previousTimestamp + p2pTime + agreementTime + chainFallbackTime and if it&#39;s posted later it&#39;s should be slashed -&amp;gt; this check is not done here - it can be done here but than it&#39;s only check on the current/next block - potentially better to ahve a geenral pipiline check for it on event trigger - since it&#39;s obective&amp;nbsp;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="-MXcLcMf_BDdAfsZCEQr-62">
