                <mxCell id="yCVjHuBSaaYtSWHuKgmm-16" value="&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span&gt;&lt;b&gt;ReduceCommitmentKilled &lt;/b&gt;-&lt;/span&gt;&lt;font&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;span&gt;&lt;font&gt;Not needed, a new reduction event will be emited on a successful challenge and slashes too&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" parent="yCVjHuBSaaYtSWHuKgmm-15" vertex="1">
