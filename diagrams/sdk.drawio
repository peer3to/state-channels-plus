                </mxCell>
                <mxCell id="2USgKruaMMoqPaF7kZq8-53" style="edgeStyle=none;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" parent="2USgKruaMMoqPaF7kZq8-40" source="2USgKruaMMoqPaF7kZq8-49" target="2USgKruaMMoqPaF7kZq8-50" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="2USgKruaMMoqPaF7kZq8-54" value="Note" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="2USgKruaMMoqPaF7kZq8-40" vertex="1" collapsed="1">
                    <mxGeometry x="385.63" y="390" width="70" height="30" as="geometry">
                        <mxRectangle x="355" y="390" width="140" height="200" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="2USgKruaMMoqPaF7kZq8-55" value="This part is optional, but recommended so a wallet doesn&#39;t poput everytime something needs to be signed - killing entirely the user experience. We use Ethers to generate a in memory hot wallet which is used to interact with the SDK&amp;nbsp;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" parent="2USgKruaMMoqPaF7kZq8-54" vertex="1">
                    <mxGeometry y="30" width="140" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="2USgKruaMMoqPaF7kZq8-57" style="edgeStyle=none;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="2USgKruaMMoqPaF7kZq8-40" source="2USgKruaMMoqPaF7kZq8-56" target="2USgKruaMMoqPaF7kZq8-64" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="2USgKruaMMoqPaF7kZq8-56" value="Connect a `signer` to the `contract instance`" style="rounded=1;whiteSpace=wrap;html=1;" parent="2USgKruaMMoqPaF7kZq8-40" vertex="1">
                    <mxGeometry x="129.38" y="500" width="242.5" height="60" as="geometry"/>
                </mxCell>
                <UserObject label="run &lt;b&gt;SDK.setup()&lt;/b&gt;&lt;br&gt;(returns a p2p contract instane and signer)" link="data:page/id,8IJa3swgfMUrxF_fh19F" id="2USgKruaMMoqPaF7kZq8-61">
                    <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="2USgKruaMMoqPaF7kZq8-40" vertex="1">
                        <mxGeometry x="129.38" y="600" width="242.5" height="60" as="geometry"/>
                    </mxCell>
                </UserObject>
                <mxCell id="2USgKruaMMoqPaF7kZq8-62" value="Note" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="2USgKruaMMoqPaF7kZq8-40" vertex="1" collapsed="1">
                    <mxGeometry x="390.63" y="610" width="70" height="30" as="geometry">
                        <mxRectangle x="360" y="600" width="140" height="460" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="2USgKruaMMoqPaF7kZq8-63" value="The p2pSigner is a normal signer extended with additional functionality and it redirects all calls to the SDK instead of an RPC node - it&#39;s polymorphically substitutable anywehre an Ethers.Signer is expected&amp;nbsp;&lt;br&gt;&lt;br&gt;The p2pContract just connects the p2pSigner to it, which redirects all calls to the SDK (local EVM) - it has the same type as the original contract instance that would be used to interact on-chain. It&#39;s fully polymorphically substitutable with the original contract =&amp;gt; you use it the same way.&lt;br&gt;&lt;br&gt;The developer experience should stay the same!&amp;nbsp;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" parent="2USgKruaMMoqPaF7kZq8-62" vertex="1">
                    <mxGeometry y="30" width="140" height="430" as="geometry"/>
                </mxCell>
                <mxCell id="2USgKruaMMoqPaF7kZq8-65" style="edgeStyle=none;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="2USgKruaMMoqPaF7kZq8-40" source="2USgKruaMMoqPaF7kZq8-64" target="2USgKruaMMoqPaF7kZq8-49" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="2USgKruaMMoqPaF7kZq8-64" value="use&amp;nbsp;&lt;b&gt;p2pSigner.join(ID)&lt;/b&gt;&amp;nbsp;to connect to other peers and join/open the channel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="2USgKruaMMoqPaF7kZq8-40" vertex="1">
                    <mxGeometry x="129.38" y="690" width="242.5" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="2USgKruaMMoqPaF7kZq8-66" value="Note" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="2USgKruaMMoqPaF7kZq8-40" vertex="1" collapsed="1">
                    <mxGeometry x="390.63" y="705" width="70" height="30" as="geometry">
                        <mxRectangle x="370" y="690" width="140" height="200" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="2USgKruaMMoqPaF7kZq8-67" value="Try and discover other peers that are observing the same &lt;b&gt;channelID&lt;/b&gt; on the DHT (Distributed Hash Table) - negotiate a connection and if succesfull negotiate opening/joining the channel&amp;nbsp;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" parent="2USgKruaMMoqPaF7kZq8-66" vertex="1">
                    <mxGeometry y="30" width="140" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="2USgKruaMMoqPaF7kZq8-68" value="Note" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="2USgKruaMMoqPaF7kZq8-40" vertex="1" collapsed="1">
                    <mxGeometry x="420.63" y="800" width="70" height="30" as="geometry">
                        <mxRectangle x="390" y="800" width="140" height="200" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="2USgKruaMMoqPaF7kZq8-69" value="There are hooks in the SDK (&lt;b&gt;p2pEventHooks&lt;/b&gt;) that trigger as callbacks to notify the user when something happen in the SDK:&lt;br&gt;&lt;b&gt;onConnection&lt;/b&gt;&lt;br&gt;&lt;b&gt;onTurn&lt;/b&gt;&lt;br&gt;...." style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" parent="2USgKruaMMoqPaF7kZq8-68" vertex="1">
                    <mxGeometry y="30" width="140" height="170" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
