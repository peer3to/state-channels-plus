                </mxCell>
                <mxCell id="ODITfQRj00F-9atufKFF-50" value="ForkId" style="rounded=1;whiteSpace=wrap;html=1;" parent="ODITfQRj00F-9atufKFF-49" vertex="1">
                    <mxGeometry x="64" y="30" width="110" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="MiHG-ok4c3-oJHMUXmo7-39" value="genesisTimestamp" style="rounded=1;whiteSpace=wrap;html=1;" parent="ODITfQRj00F-9atufKFF-49" vertex="1">
                    <mxGeometry x="65" y="90" width="110" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="ODITfQRj00F-9atufKFF-51" value="Evidence" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="ODITfQRj00F-9atufKFF-27" vertex="1">
                    <mxGeometry x="20" y="205" width="200" height="190" as="geometry">
                        <mxRectangle x="50" y="140" width="70" height="30" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="ODITfQRj00F-9atufKFF-52" value="The dispute &quot;evidence&quot; contains at most N disputes (one for every participant). In other words every participant has a chance to submit their opinion of what a dispute outcome should be for a given fork" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" parent="ODITfQRj00F-9atufKFF-51" vertex="1">
                    <mxGeometry y="30" width="200" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="ODITfQRj00F-9atufKFF-53" value="Every disputed &lt;b&gt;fork&lt;/b&gt; has a &lt;b&gt;single DisputeWindow.&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="ODITfQRj00F-9atufKFF-27" vertex="1">
                    <mxGeometry x="288" y="70" width="215" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="ODITfQRj00F-9atufKFF-54" value="Reduced Result" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="ODITfQRj00F-9atufKFF-27" vertex="1">
                    <mxGeometry x="570" y="285" width="250" height="390" as="geometry">
                        <mxRectangle x="50" y="140" width="70" height="30" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="ODITfQRj00F-9atufKFF-55" value="The reduced ruslt is generated through a deterministic algorithm (&lt;b&gt;reduce( )&lt;/b&gt;) that takes into account all disputes present in evidenence. The reduced result is a &lt;b&gt;single forkId&lt;/b&gt; which is the reality that wins and everyone builds upon.&lt;br&gt;&lt;br&gt;What&#39;s important to mention is that the order of disputes is NOT relevant. A same &lt;b&gt;combination&lt;/b&gt; (e.g. (A,B,C) or (B,C,A)...) reduces to the &lt;b&gt;same forkId&lt;/b&gt;.&amp;nbsp;&lt;br&gt;&lt;br&gt;This works like a&amp;nbsp;&lt;b&gt;CRDT&lt;/b&gt;&amp;nbsp;(conflict-free replicated data type), even though the blockchain does order them. The CRDT property allows for disputes to be created in parallel without them being aware of one another, which leads to a constant &lt;b&gt;Evidence Submission Time&lt;/b&gt; which is defined as the minimal amount of time for a user/peer to become aware of an emitted event and to allow them, with high probability, to issue and include a transaction in an on-chain block within time." style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" parent="ODITfQRj00F-9atufKFF-54" vertex="1">
                    <mxGeometry y="30" width="250" height="360" as="geometry"/>
                </mxCell>
                <mxCell id="ODITfQRj00F-9atufKFF-56" value="ForkId" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="ODITfQRj00F-9atufKFF-27" vertex="1">
                    <mxGeometry x="20" y="410" width="200" height="190" as="geometry">
                        <mxRectangle x="50" y="140" width="70" height="30" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="ODITfQRj00F-9atufKFF-57" value="The forkId is the hash of the &lt;b&gt;genesis SnapshotData&lt;/b&gt; which is the result od reduce( ) so it &lt;b&gt;unambiguously&lt;/b&gt; commits to a single genesis state (snapshot) for the winning fork.&amp;nbsp;&amp;nbsp;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" parent="ODITfQRj00F-9atufKFF-56" vertex="1">
                    <mxGeometry y="30" width="200" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="ODITfQRj00F-9atufKFF-62" value="Dispute Evidence Submission Window" style="rounded=1;whiteSpace=wrap;html=1;" parent="ODITfQRj00F-9atufKFF-27" vertex="1">
                    <mxGeometry x="1210" y="210" width="140" height="30" as="geometry"/>
                </mxCell>
