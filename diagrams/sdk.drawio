                    <mxGeometry x="145.5" y="1110" width="500" height="230" as="geometry"/>
                </mxCell>
                <mxCell id="3tbVxYwfYqRhcP25RS5C-2" value="Check:&lt;br&gt;&lt;br&gt;- correct genesisSnapshot (forkId == hash(genesisSnapshot)) - this is implicitly final&lt;br&gt;&lt;br&gt;currentSnapshot = genesisSnapshot&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;for(milestone in milestones){&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;participnats = currentSnapshot.participants&lt;br&gt;verify_participants_finalized_milestone(milestone)&lt;br&gt;verify_milestone_commits_to_snapshot(milestome,milestoneSnapshot)&lt;br&gt;verify_milestone_correct_fork(currentSnapshot,milestone)&lt;br&gt;verify_milestoneAscending (milestoneSnapshot &amp;gt; currentSnapshot)&lt;br&gt;currentSnapshot = milestoneSnapshot&lt;br&gt;}&lt;br&gt;&lt;/font&gt;&lt;br&gt;&lt;/div&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" parent="3tbVxYwfYqRhcP25RS5C-1" vertex="1">
