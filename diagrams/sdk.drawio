                </mxCell>
                <mxCell id="YYgcdZkHAL4GTBTPJZ4g-11" value="Note" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
                    <mxGeometry x="480" y="450" width="330" height="260" as="geometry">
                        <mxRectangle x="50" y="140" width="70" height="30" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="YYgcdZkHAL4GTBTPJZ4g-12" value="&lt;br&gt;&lt;span class=&quot;cf0&quot;&gt;If(&lt;/span&gt;&lt;span class=&quot;cf0&quot;&gt;onChainSnapshot.forkId&lt;/span&gt;&lt;span class=&quot;cf0&quot;&gt; == &lt;/span&gt;&lt;span class=&quot;cf0&quot;&gt;invalidBlock.forkId&lt;/span&gt;&lt;span class=&quot;cf0&quot;&gt;)&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;{&amp;nbsp;&lt;/span&gt;&lt;div&gt;&lt;span class=&quot;cf0&quot;&gt;require(invalidblock.previousBlockHash = hash(onChainSnapshot)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span class=&quot;cf0&quot;&gt;}&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span class=&quot;cf0&quot;&gt;else{&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span class=&quot;cf0&quot;&gt;reduce everything on-chain,&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span class=&quot;cf0&quot;&gt;iterate recursively to correct &lt;/span&gt;&lt;span class=&quot;cf0&quot;&gt;DisputeWindow&lt;/span&gt;&lt;span class=&quot;cf0&quot;&gt;,&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span class=&quot;cf0&quot;&gt;uploadCorrectSnapshot&lt;/span&gt;&lt;span class=&quot;cf0&quot;&gt; -&amp;gt;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span class=&quot;cf0&quot;&gt;forkId&lt;/span&gt;&lt;span class=&quot;cf0&quot;&gt; == hash(&lt;/span&gt;&lt;span class=&quot;cf0&quot;&gt;snapshotData&lt;/span&gt;&lt;span class=&quot;cf0&quot;&gt;)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span class=&quot;cf0&quot;&gt;snapshot.timestamp&lt;/span&gt;&lt;span class=&quot;cf0&quot;&gt; == &lt;/span&gt;&lt;span class=&quot;cf0&quot;&gt;window.timestamp&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span class=&quot;cf0&quot;&gt;snapshot.forkId&lt;/span&gt;&lt;span class=&quot;cf0&quot;&gt; == &lt;/span&gt;&lt;span class=&quot;cf0&quot;&gt;forkId&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span class=&quot;cf0&quot;&gt;snapshot.height&lt;/span&gt;&lt;span class=&quot;cf0&quot;&gt; == height&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span class=&quot;cf0&quot;&gt;}&lt;/span&gt;&lt;/div&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" parent="YYgcdZkHAL4GTBTPJZ4g-11" vertex="1">
                    <mxGeometry y="30" width="330" height="230" as="geometry"/>
                </mxCell>
                <mxCell id="YYgcdZkHAL4GTBTPJZ4g-13" value="Think" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="840" y="450" width="140" height="260" as="geometry">
                        <mxRectangle x="120" y="500" width="70" height="30" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="YYgcdZkHAL4GTBTPJZ4g-14" value="This requires that the DisputeWindow that reduces to &#39;forkId&#39; finalizes - killPeriod expires.&amp;nbsp;&lt;br&gt;&lt;br&gt;In such a case, better to update the onChainSnapshot and then call this fraud proof with multicall" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" parent="YYgcdZkHAL4GTBTPJZ4g-13" vertex="1">
                    <mxGeometry y="30" width="140" height="230" as="geometry"/>
                </mxCell>
                <mxCell id="v_T_giJOGtYUzAWj_742-4" value="Think" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="160" y="1001" width="220" height="170" as="geometry">
                        <mxRectangle x="120" y="500" width="70" height="30" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="v_T_giJOGtYUzAWj_742-5" value="This also covers the case if calldata is posted too late on-chain - so this should be the only fraud proof related to invalid block time" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" parent="v_T_giJOGtYUzAWj_742-4" vertex="1">
                    <mxGeometry y="30" width="220" height="140" as="geometry"/>
                </mxCell>
