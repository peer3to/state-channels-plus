                <mxCell id="Q22LJm39gkMQTBp-yN1j-3" value="Note" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="ZRMZaf2iJkQqHhPmeZ5K-1" vertex="1">
                    <mxGeometry x="880" y="180" width="500" height="210" as="geometry"/>
                </mxCell>
                <mxCell id="Q22LJm39gkMQTBp-yN1j-4" value="Disputes are the &lt;b&gt;ONLY&lt;/b&gt; way to create a fork in the system.&amp;nbsp;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;This is not a typical fork as in blockchains, where you have multiple block producers produce a block and consensus picks the winning one following a fork choice rule.&amp;nbsp;&lt;/div&gt;&lt;div&gt;Our system is designed to not have such forks and if they happen it&#39;s a result of an objective deviation in the protocol and is handled by disputes by creating a new genesis where all the byzantine/malicious actors are removed. This is the resulting fork which all honest participants accept and build on top. All of this uses a deterministic algorithm so it&#39;s easy to prove later to an independent 3rd party (blockchain or an observer) what&#39;s the canonical reality that should be taken into account when settling on-chain.&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" parent="Q22LJm39gkMQTBp-yN1j-3" vertex="1">
                    <mxGeometry y="30" width="500" height="180" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
