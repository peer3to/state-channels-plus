                        <mxRectangle x="120" y="500" width="70" height="30" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="fKzyHF-1jSRpeDUxbTSQ-64" value="All participants can always reconstruct the full Auditing Data, since they all have the full state available - &lt;b&gt;stateProof&lt;/b&gt; has to prove a final state and build on top of it so all participants can derive everything related to the &lt;b&gt;latestState&lt;/b&gt; used in disputes&amp;nbsp;&lt;br&gt;&lt;br&gt;This is only emited in some cases when &lt;b&gt;pendingParticipants &lt;/b&gt;didn&#39;t co-sign a dispute/parts of stateProof - this is to gurantee to them that they can audit and potentially challenge so even if all N participants are coluding the protocol will gurantee to them Data Availability + Safety and Liveness to enforce correcntes" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" parent="fKzyHF-1jSRpeDUxbTSQ-63" vertex="1">
                    <mxGeometry y="30" width="250" height="250" as="geometry"/>
                </mxCell>
                <mxCell id="hH5aiJ7G_QTZEotkoj1t-3" value="Note" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="KeMdtG4UYb00cbbnajk4-1">
                    <mxGeometry x="30" y="461" width="210" height="240" as="geometry">
                        <mxRectangle x="50" y="140" width="70" height="30" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="hH5aiJ7G_QTZEotkoj1t-4" value="All honest peers that are interested in the emitted disputeAuditingData are already synced at least to the genesisState of the same fork, otherwise they wouldn&#39;t even initate the joining operation on-chain, so they only have to observe and sync to a future state (if the state is newer than their perception) and verify the transitions and if everything is ok accept it, otherwise challenge the dispute on-chain" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="hH5aiJ7G_QTZEotkoj1t-3">
                    <mxGeometry y="30" width="210" height="210" as="geometry"/>
                </mxCell>
