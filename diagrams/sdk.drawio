                <mxCell id="X9zlBLXTQ7z5bdcYPX1X-18" style="edgeStyle=none;html=1;exitX=1;exitY=0.3333333333333333;exitDx=0;exitDy=0;exitPerimeter=0;" parent="1" source="X9zlBLXTQ7z5bdcYPX1X-5" target="X9zlBLXTQ7z5bdcYPX1X-1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="X9zlBLXTQ7z5bdcYPX1X-5" value="User A" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" parent="1" vertex="1">
                    <mxGeometry x="346" y="310" width="30" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="X9zlBLXTQ7z5bdcYPX1X-7" value="" style="endArrow=classic;startArrow=classic;html=1;exitX=1;exitY=0.3333333333333333;exitDx=0;exitDy=0;exitPerimeter=0;" parent="1" source="X9zlBLXTQ7z5bdcYPX1X-3" target="X9zlBLXTQ7z5bdcYPX1X-5" edge="1">
                    <mxGeometry width="50" height="50" relative="1" as="geometry">
                        <mxPoint x="436" y="300" as="sourcePoint"/>
                        <mxPoint x="486" y="250" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="X9zlBLXTQ7z5bdcYPX1X-10" value="" style="endArrow=classic;startArrow=classic;html=1;" parent="1" source="X9zlBLXTQ7z5bdcYPX1X-3" target="X9zlBLXTQ7z5bdcYPX1X-4" edge="1">
                    <mxGeometry width="50" height="50" relative="1" as="geometry">
                        <mxPoint x="276" y="450" as="sourcePoint"/>
                        <mxPoint x="356" y="390" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="X9zlBLXTQ7z5bdcYPX1X-11" value="" style="endArrow=classic;startArrow=classic;html=1;entryX=0;entryY=0.3333333333333333;entryDx=0;entryDy=0;entryPerimeter=0;" parent="1" source="X9zlBLXTQ7z5bdcYPX1X-5" target="X9zlBLXTQ7z5bdcYPX1X-4" edge="1">
                    <mxGeometry width="50" height="50" relative="1" as="geometry">
                        <mxPoint x="286" y="520" as="sourcePoint"/>
                        <mxPoint x="396" y="440" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="X9zlBLXTQ7z5bdcYPX1X-13" value="Note" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1" collapsed="1">
                    <mxGeometry x="230" y="70" width="70" height="30" as="geometry">
                        <mxRectangle x="230" y="70" width="160" height="230" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="X9zlBLXTQ7z5bdcYPX1X-14" value="The DHT is a distributed &lt;b&gt;key&lt;/b&gt; -&amp;gt; &lt;b&gt;value&lt;/b&gt; lookup and is used for peers to discover one another by finding other peers inerested in the same &lt;b&gt;key&lt;/b&gt; (hash, channeliD).&lt;br&gt;&lt;br&gt;This is not implemented by us and we currently use the Holepunch DHT. More on this in the &lt;b&gt;Networking/Discovery&lt;/b&gt; page" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" parent="X9zlBLXTQ7z5bdcYPX1X-13" vertex="1">
                    <mxGeometry y="30" width="160" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="X9zlBLXTQ7z5bdcYPX1X-15" value="Note" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1" collapsed="1">
                    <mxGeometry x="710" y="70" width="70" height="30" as="geometry">
                        <mxRectangle x="420" y="70" width="160" height="230" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="X9zlBLXTQ7z5bdcYPX1X-16" value="The &quot;&lt;b&gt;Supreme Court&lt;/b&gt;&quot;, the &lt;b&gt;single source of truth&lt;/b&gt;.&lt;br&gt;&lt;br&gt;All the shared security and liveness proprerties are inherited from the DLT (blockchain) through a deployed &lt;b&gt;StateChannelManager&lt;/b&gt; contract which follows the &lt;b&gt;DiamondProxy&lt;/b&gt; pattern (&lt;b&gt;EIP-2535&lt;/b&gt;).&lt;div&gt;&lt;br/&gt;&lt;/div&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" parent="X9zlBLXTQ7z5bdcYPX1X-15" vertex="1">
                    <mxGeometry y="30" width="160" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="97HJZ_cYjFNhWgbvmkS4-1" value="Note" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1" collapsed="1">
                    <mxGeometry x="560" y="300" width="70" height="30" as="geometry">
                        <mxRectangle x="560" y="300" width="160" height="230" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="97HJZ_cYjFNhWgbvmkS4-2" value="NOTE: &lt;b&gt;All users&lt;/b&gt; are connected to the DHT and Blockchain (not just one - didn&#39;t want to clog up the diagram)&lt;br&gt;&lt;br&gt;Idealy, for the sake of user experience, all connections are bidirectional (Web)Sockets, so the communication is in real-time.&amp;nbsp;&lt;br&gt;&lt;br&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" parent="97HJZ_cYjFNhWgbvmkS4-1" vertex="1">
                    <mxGeometry y="30" width="160" height="200" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="8IJa3swgfMUrxF_fh19F" name="Setup/VM">
        <mxGraphModel dx="1684" dy="824" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="J-vIkx5o-MgWQqyid1y3-1" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Intro&lt;/h1&gt;&lt;p&gt;&lt;b&gt;This is our local environemnt (client side/off-chain) NOT on-chain.&lt;/b&gt;&lt;br&gt;&lt;br&gt;Long term we want to support multiple VMs (EVM,PVM...) so we made an abstraction aVM (which for now we&#39;re caling AStateMachine) in the typescript code.&lt;br&gt;&lt;br&gt;For now we only have the EVM implemented (EVMStateMachine).&lt;br&gt;&lt;br&gt;The user of the SDK needs to pick which VM they want to use, by calling the appropriate &lt;b&gt;setup&lt;/b&gt; function which instantiates all the compontents and gives the user the &lt;b&gt;p2pContractInstace&lt;/b&gt; and &lt;b&gt;p2pSigner&lt;/b&gt; which they use to interact with the system in a familiar way with all the complexity hidden.&lt;br&gt;&lt;br&gt;Locally we &lt;u&gt;deploy&lt;/u&gt; the &lt;b&gt;concrete state machine contract&lt;/b&gt; (e.g. Poker, Chess...) which will execute in rea-time p2p between users (off-chain).&amp;nbsp;&lt;br&gt;&lt;br&gt;We also &lt;u&gt;deploy&lt;/u&gt; a &lt;b&gt;LocalDiamond&lt;/b&gt; with the &lt;b&gt;same facets&lt;/b&gt; as the diamond deployed on-chain. The only difference being the local diamond exposes an interface to &lt;b&gt;unconditionally set storage slots&lt;/b&gt; (state variables) which we use to sync the off-chain state to the on-chain one when needed. &lt;br&gt;&lt;br&gt;We do all of this so we can &lt;b&gt;reuse&lt;/b&gt; the same validation logic that runs on-chain, so we don&#39;t have to have a seperate implementation which also reduces the chance of bugs (differences in typescript/sodlitiy implementations).&lt;br&gt;&lt;br&gt;So the point of our EVMStateMachine (and any other specific VM) is to make it easy to interact locally with these contracts from our typescript code. Internally it runs the official EVM supported by the Ethereum Foundation. In general we&#39;ll try to not implement the VMs, just reuse official implementations and wrap them to accomodate our systems.&lt;br&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="30" y="80" width="300" height="680" as="geometry"/>
                </mxCell>
                <mxCell id="zkgn0tuZ4sNgNVOaiEEn-5" value="Note" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1" collapsed="1">
                    <mxGeometry x="660" y="250" width="70" height="30" as="geometry">
                        <mxRectangle x="680" y="225" width="140" height="410" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="zkgn0tuZ4sNgNVOaiEEn-6" value="Currently this is named &lt;b&gt;AStateMachine&lt;/b&gt; which is &lt;u&gt;confusing&lt;/u&gt; since it&#39;s ambiguous to the AStateMachine contract from solidity.&lt;br&gt;&lt;br&gt;&lt;b&gt;aVM&lt;/b&gt; is also &lt;u&gt;not true &lt;/u&gt;since it doesn&#39;t imlement a VM it just uses a specific one&amp;nbsp;&lt;br&gt;&lt;br&gt;Not sure what the name should be (maybe VmManager), but what it does is:&lt;br&gt;&lt;br&gt;exposes an interface to interact with the &lt;b&gt;LocalDiamond&lt;/b&gt; and &lt;b&gt;AStateMachine contract&lt;/b&gt; withouth knowing what the concrete state machine contract implementation." style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" parent="zkgn0tuZ4sNgNVOaiEEn-5" vertex="1">
                    <mxGeometry y="30" width="140" height="380" as="geometry"/>
                </mxCell>
                <mxCell id="zkgn0tuZ4sNgNVOaiEEn-7" value="AStateMachine / aVM" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="410" y="240" width="230" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="zkgn0tuZ4sNgNVOaiEEn-9" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;" parent="zkgn0tuZ4sNgNVOaiEEn-7" vertex="1">
                    <mxGeometry y="26" width="230" height="8" as="geometry"/>
                </mxCell>
                <mxCell id="zkgn0tuZ4sNgNVOaiEEn-10" value="+ all LocalDiamondProxy methods&lt;br&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;+ all AStateMachine contract methods&lt;br&gt;+ setup&lt;/span&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" parent="zkgn0tuZ4sNgNVOaiEEn-7" vertex="1">
                    <mxGeometry y="34" width="230" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="zkgn0tuZ4sNgNVOaiEEn-11" value="General High Level" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;recursiveResize=0;container=1;collapsible=0;width=160;" parent="1" vertex="1">
                    <mxGeometry x="370" y="180" width="450" height="420" as="geometry"/>
                </mxCell>
                <mxCell id="zkgn0tuZ4sNgNVOaiEEn-1" value="EVMStateMachine&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;" parent="zkgn0tuZ4sNgNVOaiEEn-11" vertex="1">
                    <mxGeometry x="40" y="240" width="230" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="zkgn0tuZ4sNgNVOaiEEn-2" value="+ EVM" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" parent="zkgn0tuZ4sNgNVOaiEEn-1" vertex="1">
                    <mxGeometry y="26" width="230" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="zkgn0tuZ4sNgNVOaiEEn-3" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;" parent="zkgn0tuZ4sNgNVOaiEEn-1" vertex="1">
                    <mxGeometry y="50" width="230" height="8" as="geometry"/>
                </mxCell>
                <mxCell id="zkgn0tuZ4sNgNVOaiEEn-4" value="&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;+ all LocalDiamondProxy methods&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;+ all AStateMachine contract methods&lt;br&gt;+ setup&lt;/span&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" parent="zkgn0tuZ4sNgNVOaiEEn-1" vertex="1">
                    <mxGeometry y="58" width="230" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="zkgn0tuZ4sNgNVOaiEEn-12" value="Extends" style="endArrow=block;endSize=16;endFill=0;html=1;entryX=0.465;entryY=1.054;entryDx=0;entryDy=0;entryPerimeter=0;exitX=0.465;exitY=-0.033;exitDx=0;exitDy=0;exitPerimeter=0;" parent="1" source="zkgn0tuZ4sNgNVOaiEEn-1" target="zkgn0tuZ4sNgNVOaiEEn-10" edge="1">
                    <mxGeometry width="160" relative="1" as="geometry">
                        <mxPoint x="480" y="400" as="sourcePoint"/>
