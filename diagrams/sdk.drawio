                <mxCell id="ODITfQRj00F-9atufKFF-49" value="Reduced Result" style="swimlane;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="ODITfQRj00F-9atufKFF-41" vertex="1">
