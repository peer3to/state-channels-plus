                <mxCell id="2USgKruaMMoqPaF7kZq8-35" value="A signer is an abstraction of a public/private key pair. Usually it connects to a wallet like Metamask that actually contains the public/private key and does the signing" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" parent="2USgKruaMMoqPaF7kZq8-34" vertex="1">
