{
    "compilerOptions": {
        "target": "es2020",
        // es2022.error only: the standard `new Error(msg, { cause })` option.
        "lib": ["es2020", "es2022.error", "dom", "dom.iterable", "scripthost"],
        "module": "commonjs",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "outDir": "./dist",
        "declaration": true,
        "sourceMap": true,
        "baseUrl": ".",
        "paths": {
            "@/*": ["src/*"],
            "@platform/createLogger": ["src/utils/logging/node/createLogger"],
            "@platform/contractExecutorRootUrl": [
                "src/rpc/internal/node/ContractExecutorRootUrl"
            ],
            "@platform/p2pRuntimeHostRootUrl": [
                "src/rpc/internal/node/P2pRuntimeHostRootUrl"
            ],
            "@platform/rootWorkerRuntime": [
                "src/rpc/internal/node/RootWorkerRuntime"
            ],
            "@platform/p2pRuntimeChannel": [
                "src/transport/node/RuntimeChannel"
            ],
            "@platform/DeployUtils": ["src/utils/node/DeployUtils"],
            "@platform/LocalDiscoveryServer": [
                "src/utils/node/LocalDiscoveryServer"
            ],
            "@platform/evmJumpdestCache": ["src/evm/node/evmJumpdestCache"],
            "@platform/moduleLoader": [
                "src/utils/moduleLoader/node/importModuleFromManifest"
            ],
            "@test/*": ["test/*"],
            "@typechain-types/*": ["typechain-types/*"],
            "@typechain-types": ["typechain-types/index"]
        }
    },
    "exclude": [
        "src/utils/moduleLoader/browser",
        "src/rpc/internal/browser",
        "src/transport/browser",
        "examples",
        "dist",
        "logs",
        "temp",
        "node_modules",
        "src/evm/browser",
        "src/utils/browser",
        "src/utils/logging/browser",
        "test/evm/workers/browser"
    ],
    "ts-node": {
        "require": ["tsconfig-paths/register"],
        "swc": true
    }
}
